# ---------------------------------------------------------------
# NovaVoxNET — fichiers générés/locaux à ne jamais versionner
# ---------------------------------------------------------------

# Sorties de build .NET
bin/
obj/
out/

# Publication autonome (build.bat) / installateur Inno Setup (installer.iss)
dist/
Output/

# Modèles/moteurs téléchargés localement par l'appli (trop volumineux pour Git)
model/
piper/

# Journal texte généré à l'exécution (voir NovaVox.Core.AppLog)
Log/

# Manifest de mise à jour régénéré à chaque build (voir build.bat) —
# jamais la source de vérité, seulement une copie locale avant envoi.
novavoxnet_version.json

# URL de webhook Discord (secrète, jamais versionnée) — voir notify_discord.ps1
discord_webhook.txt
discord_first_post.txt

# Diagnostic temporaire (payload JSON exact envoyé) — voir notify_discord.ps1
discord_payload_debug.txt

# Détails de connexion SSH vers le serveur de déploiement (IP, utilisateur,
# nom de la clé) -- secret, jamais versionné — voir build.bat
deploy_config.txt

# Notes personnelles locales, pas une source de vérité ni lue par le code
docs/
docs/game_log_destinations_catalogue.txt

# Éditeurs / OS
.vs/
.vscode/
.idea/
Thumbs.db
.DS_Store
