<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\icon.ico</ApplicationIcon>
    <AssemblyName>NovaVox</AssemblyName>
    <RootNamespace>NovaVox.App</RootNamespace>
    <!-- Permet de faire dotnet restore/build sur une machine non-Windows
         (utile en CI ou en édition à distance) ; la compilation XAML
         complète (BAML) reste réservée à une machine Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sans UseWindowsForms, le SDK WPF n'ajoute PAS System.IO aux usings
         implicites (seulement les espaces de noms WPF) — File/Path sont
         utilisés dans plusieurs fichiers (TrayIconService, PiperTtsEngine,
         UpdateChecker, StarCitizenAutolaunch, MainWindow...). -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vosk" Version="0.3.38" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Vortice.DirectInput" Version="3.8.3" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NovaVox.Core\NovaVox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copié à côté de NovaVox.exe : l'icône du tray est chargée depuis
         le disque à l'exécution (voir TrayIconService), pas depuis les
         ressources embarquées, pour rester cohérente avec l'icône .exe
         elle-même sans dupliquer le fichier dans le dépôt. -->
    <Content Include="..\..\icon.ico" Link="icon.ico" CopyToOutputDirectory="PreserveNewest" />

    <!-- Numéro de version + notes de mise à jour (VersionUtil.GetAppVersion/
         GetPatchNotes) : la toute première ligne "vX.Y.Z" du fichier fait foi,
         donc il suffit d'ajouter un nouveau bloc en tête à chaque version —
         pas de numéro à dupliquer ailleurs dans le code. -->
    <Content Include="..\..\patch_maj.txt" Link="patch_maj.txt" CopyToOutputDirectory="PreserveNewest" />

    <!-- Logo d'en-tête / image de fond des listes Commandes+Journal
         (LoadAppLogoImage/LoadPanelsBackgroundImage, MainWindow.xaml.cs) :
         optionnels, absents du dépôt tant que l'utilisateur n'en dépose pas
         à la racine (à côté d'icon.ico) — Condition="Exists(...)" évite un
         échec de build en leur absence. Copiés à côté de NovaVox.exe comme
         icon.ico, plutôt que de rester seulement dans bin/ (ignoré par Git,
         donc perdus au moindre clonage/dotnet clean ailleurs). -->
    <Content Include="..\..\logo.png" Link="logo.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\logo.png')" />
    <Content Include="..\..\logo.jpg" Link="logo.jpg" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\logo.jpg')" />
    <Content Include="..\..\logo.jpeg" Link="logo.jpeg" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\logo.jpeg')" />
    <Content Include="..\..\background.jpg" Link="background.jpg" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\background.jpg')" />
    <Content Include="..\..\background.jpeg" Link="background.jpeg" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\background.jpeg')" />
    <Content Include="..\..\background.png" Link="background.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\background.png')" />

    <!-- Même principe pour l'image de fond du mode "Autre jeu" (voir
         GameModeCombo_SelectionChanged/LoadPanelsBackgroundImage,
         MainWindow.xaml.cs) : sans ces entrées, background2.* restait à la
         racine du dépôt mais n'était jamais copié à côté de NovaVox.exe,
         donc jamais trouvé au lancement. -->
    <Content Include="..\..\background2.jpg" Link="background2.jpg" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\background2.jpg')" />
    <Content Include="..\..\background2.jpeg" Link="background2.jpeg" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\background2.jpeg')" />
    <Content Include="..\..\background2.png" Link="background2.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\background2.png')" />
  </ItemGroup>

</Project>
