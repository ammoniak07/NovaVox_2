<Application x:Class="NovaVox.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NovaVox.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Palette de couleurs : remplacée à l'exécution pour le
                     mode jour/nuit (voir ThemeManager). Doit rester en
                     premier, avant Theme.xaml qui en dépend. -->
                <ResourceDictionary Source="Resources/Theme.Dark.xaml" />
                <ResourceDictionary Source="Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Global (pas juste MainWindow.xaml) : réutilisé par
                 OverlayWindow.xaml pour la couleur par repère de l'aide-
                 mémoire vaisseaux, voir ShipCheatSheetPointRowVm.Color. -->
            <converters:HexColorToBrushConverter x:Key="HexColorToBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
