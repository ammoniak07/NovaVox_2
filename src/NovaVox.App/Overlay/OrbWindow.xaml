<Window x:Class="NovaVox.App.Overlay.OrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NovaVox Bulle"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="280" Height="300">
    <Grid>
        <Canvas x:Name="OrbCanvas" IsHitTestVisible="True" Background="#01000000">
            <!-- Halo chaud : même forme que la bulle, très floutée derrière elle. -->
            <Path x:Name="GlowPath" Opacity="0.55">
                <Path.Fill>
                    <SolidColorBrush x:Name="GlowBrush" Color="#ffcf70" />
                </Path.Fill>
                <Path.Effect>
                    <BlurEffect x:Name="GlowBlur" Radius="48" KernelType="Gaussian" RenderingBias="Performance" />
                </Path.Effect>
            </Path>
            <!-- Ondes d'écoute (sonar) : contours de la bulle qui grandissent et
                 s'effacent quand elle t'entend. Créés dans le code. -->
            <Canvas x:Name="RingLayer" IsHitTestVisible="False">
                <Canvas.Effect>
                    <BlurEffect x:Name="RingBlur" Radius="2" KernelType="Gaussian" RenderingBias="Performance" />
                </Canvas.Effect>
            </Canvas>
            <!-- Glitch holographique (erreur) : copies rouge et cyan décalées derrière la bulle. -->
            <Path x:Name="GlitchRed" Opacity="0" Fill="#c0ff2050" />
            <Path x:Name="GlitchCyan" Opacity="0" Fill="#c020e0ff" />
            <!-- (Test) Oreilles humaines sur les côtés : pavillon, creux intérieur
                 plus foncé, pli en relief. Dessinées derrière le corps : seule la
                 partie qui dépasse de la bulle est visible. -->
            <Canvas x:Name="EarGroup" Opacity="0">
                <Path x:Name="EarLeft">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop x:Name="EarLeftTop" Offset="0" Color="#fff6b866" />
                            <GradientStop x:Name="EarLeftBottom" Offset="1" Color="#fff0985a" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Path x:Name="EarRight">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop x:Name="EarRightTop" Offset="0" Color="#fff6b866" />
                            <GradientStop x:Name="EarRightBottom" Offset="1" Color="#fff0985a" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Path x:Name="EarLeftInner">
                    <Path.Fill>
                        <SolidColorBrush x:Name="EarLeftInnerBrush" Color="#c0a04a5a" />
                    </Path.Fill>
                    <Path.Effect>
                        <BlurEffect x:Name="EarLeftInnerBlur" Radius="2" KernelType="Gaussian" RenderingBias="Performance" />
                    </Path.Effect>
                </Path>
                <Path x:Name="EarRightInner">
                    <Path.Fill>
                        <SolidColorBrush x:Name="EarRightInnerBrush" Color="#c0a04a5a" />
                    </Path.Fill>
                    <Path.Effect>
                        <BlurEffect x:Name="EarRightInnerBlur" Radius="2" KernelType="Gaussian" RenderingBias="Performance" />
                    </Path.Effect>
                </Path>
                <Path x:Name="EarLeftFold" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Stroke>
                        <SolidColorBrush x:Name="EarLeftFoldBrush" Color="#c8ffffff" />
                    </Path.Stroke>
                    <Path.Effect>
                        <BlurEffect x:Name="EarLeftFoldBlur" Radius="1.5" KernelType="Gaussian" RenderingBias="Performance" />
                    </Path.Effect>
                </Path>
                <Path x:Name="EarRightFold" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Stroke>
                        <SolidColorBrush x:Name="EarRightFoldBrush" Color="#c8ffffff" />
                    </Path.Stroke>
                    <Path.Effect>
                        <BlurEffect x:Name="EarRightFoldBlur" Radius="1.5" KernelType="Gaussian" RenderingBias="Performance" />
                    </Path.Effect>
                </Path>
            </Canvas>
            <!-- Corps : dégradé radial (clair en haut à gauche, plus sombre vers le bord). -->
            <Path x:Name="BodyPath">
                <Path.Fill>
                    <RadialGradientBrush x:Name="BodyBrush" GradientOrigin="0.35,0.3" Center="0.45,0.42" RadiusX="0.75" RadiusY="0.75">
                        <GradientStop x:Name="StopHighlight" Offset="0" Color="#ffe9a8" />
                        <GradientStop x:Name="StopLight" Offset="0.35" Color="#f6b866" />
                        <GradientStop x:Name="StopMain" Offset="0.8" Color="#f0985a" />
                        <GradientStop x:Name="StopEdge" Offset="1" Color="#d27070" />
                    </RadialGradientBrush>
                </Path.Fill>
            </Path>
            <!-- Nuance : chaud en haut à gauche, rosé en bas à droite. -->
            <Path x:Name="ShadePath">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0.1,0.05" EndPoint="0.95,0.95">
                        <GradientStop x:Name="ShadeWarm" Offset="0" Color="#80ffd27a" />
                        <GradientStop Offset="0.5" Color="#00000000" />
                        <GradientStop x:Name="ShadeCool" Offset="1" Color="#90c0607a" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <!-- Taches de couleur intérieures (plus claires et plus foncées que la
                 couleur choisie) qui dérivent et se mélangent comme un liquide.
                 Floutées ensemble, puis découpées à la forme de la bulle. -->
            <Canvas x:Name="SpotClip">
                <Canvas x:Name="SpotLayer">
                    <Canvas.Effect>
                        <BlurEffect x:Name="SpotBlur" Radius="20" KernelType="Gaussian" RenderingBias="Performance" />
                    </Canvas.Effect>
                </Canvas>
            </Canvas>
            <!-- Lueur intérieure du bord : trait épais très flouté, découpé à la
                 forme de la bulle (on n'en voit que la moitié intérieure, qui se
                 fond vers le centre). Plus intense d'un côté, et ce côté tourne
                 lentement ; l'intensité suit aussi la voix. -->
            <Path x:Name="RimPath" StrokeThickness="12" Opacity="0.7">
                <Path.Stroke>
                    <LinearGradientBrush x:Name="RimBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="RimStopStrong" Offset="0" Color="#ffff5a6a" />
                        <GradientStop x:Name="RimStopSoft" Offset="0.55" Color="#30ff5a6a" />
                        <GradientStop x:Name="RimStopEnd" Offset="1" Color="#a0ff5a6a" />
                    </LinearGradientBrush>
                </Path.Stroke>
                <Path.Effect>
                    <BlurEffect x:Name="RimBlur" Radius="8" KernelType="Gaussian" RenderingBias="Performance" />
                </Path.Effect>
            </Path>
            <!-- (Test) Ondes d'écoute à l'intérieur : même anneaux, du noyau vers le bord, découpés à la bulle. -->
            <Canvas x:Name="InnerRingLayer" IsHitTestVisible="False">
                <Canvas.Effect>
                    <BlurEffect x:Name="InnerRingBlur" Radius="2" KernelType="Gaussian" RenderingBias="Performance" />
                </Canvas.Effect>
            </Canvas>
            <!-- Réflexion : réseau de particules reliées qui tournent dans la bulle. -->
            <Canvas x:Name="NeuralClip" Opacity="0" IsHitTestVisible="False">
                <Path x:Name="NeuralLines" StrokeThickness="1">
                    <Path.Stroke>
                        <SolidColorBrush x:Name="NeuralBrush" Color="#70ffffff" />
                    </Path.Stroke>
                </Path>
                <Canvas x:Name="NeuralDots" />
            </Canvas>
            <!-- Noyau lumineux : la présence de Nova (halo doux + cœur brillant). -->
            <Canvas x:Name="CoreGroup" Opacity="0" IsHitTestVisible="False">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="CoreScale" />
                </Canvas.RenderTransform>
                <Ellipse x:Name="CoreHalo">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop x:Name="CoreHaloCenter" Offset="0" Color="#c0ffffff" />
                            <GradientStop x:Name="CoreHaloMid" Offset="0.45" Color="#50ffffff" />
                            <GradientStop x:Name="CoreHaloEdge" Offset="1" Color="#00ffffff" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="CoreDot">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.4,0.35">
                            <GradientStop Offset="0" Color="#ffffffff" />
                            <GradientStop x:Name="CoreDotMid" Offset="0.55" Color="#fff0faff" />
                            <GradientStop x:Name="CoreDotEdge" Offset="1" Color="#00ffffff" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>
            <!-- Onde de voix : deux ondes lumineuses (et leur halo) qui traversent la bulle. -->
            <Canvas x:Name="WaveGroup" Opacity="0" IsHitTestVisible="False">
                <Path x:Name="WaveGlow" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0.6">
                    <Path.Stroke>
                        <SolidColorBrush x:Name="WaveGlowBrush" Color="#ffffffff" />
                    </Path.Stroke>
                    <Path.Effect>
                        <BlurEffect x:Name="WaveGlowBlur" Radius="6" KernelType="Gaussian" RenderingBias="Performance" />
                    </Path.Effect>
                </Path>
                <Path x:Name="WavePath2" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Opacity="0.5">
                    <Path.Stroke>
                        <SolidColorBrush x:Name="WaveBrush2" Color="#ffffffff" />
                    </Path.Stroke>
                </Path>
                <Path x:Name="WavePath" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                    <Path.Stroke>
                        <SolidColorBrush x:Name="WaveBrush" Color="#ffffffff" />
                    </Path.Stroke>
                </Path>
            </Canvas>
            <!-- Commande exécutée : bande de lumière qui balaie la bulle. -->
            <Path x:Name="ShimmerPath" Opacity="0" IsHitTestVisible="False">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="ShimmerStop0" Offset="0" Color="#00ffffff" />
                        <GradientStop x:Name="ShimmerStop1" Offset="0.1" Color="#d0ffffff" />
                        <GradientStop x:Name="ShimmerStop2" Offset="0.2" Color="#00ffffff" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <!-- (Test) Bouche : intérieur sombre avec ombre en haut, langue rosée au
                 fond quand elle s'ouvre, lèvres douces et lumineuses autour. -->
            <Canvas x:Name="MouthGroup" Opacity="0">
                <Path x:Name="MouthPath">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop x:Name="MouthStopTop" Offset="0" Color="#f0100408" />
                            <GradientStop x:Name="MouthStopMid" Offset="0.55" Color="#e0200810" />
                            <GradientStop x:Name="MouthStopBottom" Offset="1" Color="#d0401020" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
                <Path x:Name="TonguePath" Opacity="0">
                    <Path.Fill>
                        <RadialGradientBrush GradientOrigin="0.5,0.3" Center="0.5,0.45" RadiusX="0.55" RadiusY="0.6">
                            <GradientStop x:Name="TongueStopLight" Offset="0" Color="#ffe08a9a" />
                            <GradientStop x:Name="TongueStopDark" Offset="1" Color="#ffa04a5a" />
                        </RadialGradientBrush>
                    </Path.Fill>
                </Path>
                <Path x:Name="LipPath" StrokeThickness="3" Opacity="0.7">
                    <Path.Stroke>
                        <SolidColorBrush x:Name="LipBrush" Color="#ffffd0b0" />
                    </Path.Stroke>
                    <Path.Effect>
                        <BlurEffect x:Name="LipBlur" Radius="2.5" KernelType="Gaussian" RenderingBias="Performance" />
                    </Path.Effect>
                </Path>
            </Canvas>
            <!-- Petit reflet brillant en haut à gauche. -->
            <Ellipse x:Name="Highlight" Width="30" Height="22">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#e6fffbe0" />
                        <GradientStop Offset="1" Color="#00fffbe0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Réflexion : petits satellites en orbite autour de la bulle. -->
            <Canvas x:Name="SatelliteLayer" Opacity="0" IsHitTestVisible="False" />
            <!-- Repère visible uniquement en mode "Déplacer la bulle". -->
            <Ellipse x:Name="MoveHint" Stroke="#dbe4ee" StrokeThickness="1.5" StrokeDashArray="4 3" Visibility="Collapsed" />
        </Canvas>
        <TextBlock x:Name="CaptionText" Text="Je réfléchis…" Foreground="#e6edf5" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                   Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.9" Color="Black" />
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
