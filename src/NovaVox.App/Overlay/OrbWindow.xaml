<Window x:Class="NovaVox.App.Overlay.OrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NovaVox Bulle"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="280" Height="300">
    <Grid>
        <Canvas x:Name="OrbCanvas" IsHitTestVisible="True" Background="#01000000">
            <!-- Halo chaud : même forme que la bulle, très floutée derrière elle. -->
            <Path x:Name="GlowPath" Opacity="0.55">
                <Path.Fill>
                    <SolidColorBrush x:Name="GlowBrush" Color="#ffcf70" />
                </Path.Fill>
                <Path.Effect>
                    <BlurEffect x:Name="GlowBlur" Radius="48" KernelType="Gaussian" RenderingBias="Performance" />
                </Path.Effect>
            </Path>
            <!-- Trait de lumière sous la bulle, comme un reflet sur une surface. -->
            <Rectangle x:Name="FloorLine" Height="2" RadiusX="1" RadiusY="1">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop x:Name="FloorStop" Offset="0.5" Color="#80ffcf70" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- Corps : dégradé radial (clair en haut à gauche, plus sombre vers le bord). -->
            <Path x:Name="BodyPath">
                <Path.Fill>
                    <RadialGradientBrush x:Name="BodyBrush" GradientOrigin="0.35,0.3" Center="0.45,0.42" RadiusX="0.75" RadiusY="0.75">
                        <GradientStop x:Name="StopHighlight" Offset="0" Color="#ffe9a8" />
                        <GradientStop x:Name="StopLight" Offset="0.35" Color="#f6b866" />
                        <GradientStop x:Name="StopMain" Offset="0.8" Color="#f0985a" />
                        <GradientStop x:Name="StopEdge" Offset="1" Color="#d27070" />
                    </RadialGradientBrush>
                </Path.Fill>
            </Path>
            <!-- Nuance : chaud en haut à gauche, rosé en bas à droite. -->
            <Path x:Name="ShadePath">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0.1,0.05" EndPoint="0.95,0.95">
                        <GradientStop x:Name="ShadeWarm" Offset="0" Color="#80ffd27a" />
                        <GradientStop Offset="0.5" Color="#00000000" />
                        <GradientStop x:Name="ShadeCool" Offset="1" Color="#90c0607a" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <!-- Lumière intérieure qui tourne lentement dans la bulle (plus vite et
                 plus forte quand elle réfléchit) : impression de vie à l'intérieur. -->
            <Ellipse x:Name="InnerGlow" Width="80" Height="80" Opacity="0.35">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop x:Name="InnerStopCenter" Offset="0" Color="#c0fff0b8" />
                        <GradientStop x:Name="InnerStopEdge" Offset="1" Color="#00fff0b8" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect x:Name="InnerBlur" Radius="10" KernelType="Gaussian" RenderingBias="Performance" />
                </Ellipse.Effect>
            </Ellipse>
            <!-- Lueur intérieure du bord : trait épais très flouté, découpé à la
                 forme de la bulle (on n'en voit que la moitié intérieure, qui se
                 fond vers le centre). Plus intense d'un côté, et ce côté tourne
                 lentement ; l'intensité suit aussi la voix. -->
            <Path x:Name="RimPath" StrokeThickness="12" Opacity="0.7">
                <Path.Stroke>
                    <LinearGradientBrush x:Name="RimBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="RimStopStrong" Offset="0" Color="#ffff5a6a" />
                        <GradientStop x:Name="RimStopSoft" Offset="0.55" Color="#30ff5a6a" />
                        <GradientStop x:Name="RimStopEnd" Offset="1" Color="#a0ff5a6a" />
                    </LinearGradientBrush>
                </Path.Stroke>
                <Path.Effect>
                    <BlurEffect x:Name="RimBlur" Radius="8" KernelType="Gaussian" RenderingBias="Performance" />
                </Path.Effect>
            </Path>
            <!-- Petit reflet brillant en haut à gauche. -->
            <Ellipse x:Name="Highlight" Width="30" Height="22">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#e6fffbe0" />
                        <GradientStop Offset="1" Color="#00fffbe0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Repère visible uniquement en mode "Déplacer la bulle". -->
            <Ellipse x:Name="MoveHint" Stroke="#dbe4ee" StrokeThickness="1.5" StrokeDashArray="4 3" Visibility="Collapsed" />
        </Canvas>
        <TextBlock x:Name="CaptionText" Text="Je réfléchis…" Foreground="#e6edf5" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                   Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.9" Color="Black" />
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
