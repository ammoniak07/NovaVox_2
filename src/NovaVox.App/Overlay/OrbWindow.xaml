<Window x:Class="NovaVox.App.Overlay.OrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NovaVox Bulle"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="280" Height="300">
    <Grid>
        <Canvas x:Name="OrbCanvas" IsHitTestVisible="True" Background="#01000000">
            <!-- Halo : même forme que la bulle, floutée derrière elle. -->
            <Path x:Name="GlowPath" Opacity="0.7">
                <Path.Fill>
                    <SolidColorBrush x:Name="GlowBrush" Color="#38bdf8" />
                </Path.Fill>
                <Path.Effect>
                    <BlurEffect x:Name="GlowBlur" Radius="36" KernelType="Gaussian" RenderingBias="Performance" />
                </Path.Effect>
            </Path>
            <!-- Corps : dégradé radial avec un reflet clair en haut, comme une goutte lumineuse. -->
            <Path x:Name="BodyPath">
                <Path.Fill>
                    <RadialGradientBrush x:Name="BodyBrush" GradientOrigin="0.42,0.28" Center="0.5,0.45" RadiusX="0.72" RadiusY="0.72">
                        <GradientStop x:Name="StopHighlight" Offset="0" Color="#fff6c8" />
                        <GradientStop x:Name="StopLight" Offset="0.3" Color="#7dd3fc" />
                        <GradientStop x:Name="StopMain" Offset="0.75" Color="#38bdf8" />
                        <GradientStop x:Name="StopEdge" Offset="1" Color="#0c4a6e" />
                    </RadialGradientBrush>
                </Path.Fill>
            </Path>
            <!-- Repère visible uniquement en mode "Déplacer la bulle". -->
            <Ellipse x:Name="MoveHint" Stroke="#dbe4ee" StrokeThickness="1.5" StrokeDashArray="4 3" Visibility="Collapsed" />
        </Canvas>
        <TextBlock x:Name="CaptionText" Text="Je réfléchis…" Foreground="#e6edf5" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                   Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.9" Color="Black" />
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
