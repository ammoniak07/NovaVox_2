<Window x:Class="NovaVox.App.Overlay.OverlaySatelliteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NovaVox Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <!--
        Fenêtre "satellite" : créée par OverlayWindow.DetachRowToNewWindow
        quand une ligne est glissée hors des limites de sa fenêtre actuelle
        (overlay principal ou un autre satellite) — voir le commentaire sur
        OverlayWindow._windows pour l'architecture d'ensemble. Volontairement
        minimale : AUCUNE ligne n'est déclarée ici (contrairement à
        OverlayWindow.xaml qui déclare les 9 lignes) — seules des colonnes
        vides, remplies dynamiquement en déplaçant des Grid déjà existants
        (toujours propriété de l'unique instance OverlayWindow "principale",
        jamais recréés ici) depuis une autre fenêtre. Les styles utilisés
        par leur contenu (OverlayRowCheckboxStyle, OverlayRowDragHandleStyle)
        restent résolus une fois pour toutes au chargement de
        OverlayWindow.xaml (StaticResource, pas DynamicResource) : ils
        continuent de s'appliquer normalement après un tel déplacement, pas
        besoin de les redéclarer ici.
    -->
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="OverlayScaleTransform" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Border x:Name="PanelBorder"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="#592DD4FF"
                Padding="12,10">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="18" ShadowDepth="4" Direction="270" />
            </Border.Effect>
            <StackPanel x:Name="ColumnsPanel" Orientation="Horizontal">
                <StackPanel x:Name="Column0" />
                <StackPanel x:Name="Column1" />
                <StackPanel x:Name="Column2" />
                <StackPanel x:Name="Column3" />
                <StackPanel x:Name="Column4" />
                <StackPanel x:Name="Column5" />
                <StackPanel x:Name="Column6" />
                <StackPanel x:Name="Column7" />
                <StackPanel x:Name="Column8" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
