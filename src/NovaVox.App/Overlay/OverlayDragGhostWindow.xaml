<Window x:Class="NovaVox.App.Overlay.OverlayDragGhostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NovaVox Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight">
    <!--
        Aperçu flottant qui suit le curseur pendant le glisser d'une ligne
        (voir OverlayWindow.ShowDragGhost/UpdateDragGhostPosition) — un
        instantané (RenderTargetBitmap) de la ligne au moment où le glisser
        commence, PAS un second exemplaire "vivant" du Grid réellement
        déplacé (qui continue, lui, à changer réellement de colonne/fenêtre
        en direct). Toujours clic-traversant (IsHitTestVisible="False" +
        WS_EX_TRANSPARENT dès la création) : un pur repère visuel, jamais une
        cible de glisser-déposer.
    -->
    <Border CornerRadius="6" Background="#40000000" Padding="6,4">
        <Image x:Name="GhostImage" Opacity="0.82" Stretch="None" />
    </Border>
</Window>
