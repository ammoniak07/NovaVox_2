<Window x:Class="NovaVox.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NovaVox Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <Window.Resources>
        <!-- Case à cocher compacte pour choisir les lignes affichées, visible
             uniquement en mode "déplacer" (déverrouillé) — voir SetEditMode/
             RefreshRowVisualsForEditMode. Style minimal indépendant de
             Theme.xaml (cette fenêtre ne le fusionne pas), coloré comme le
             reste de l'overlay (cyan d'accent, texte clair). -->
        <Style x:Key="OverlayRowCheckboxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <!-- La case visible ne fait que 14x14, mais la zone cliquable réelle
                 est celle du Grid racine du template (Background="Transparent"
                 explicite pour être hit-testable partout, pas seulement là où
                 quelque chose est dessiné) : 24x24, sinon un clic à quelques
                 pixels de la case rate sa cible et retombe sur le panneau
                 derrière, ce qui déclenche un déplacement de l'overlay au lieu
                 de cocher/décocher. -->
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="Box" Width="14" Height="14" Background="#33FFFFFF"
                                    BorderBrush="#2DD4FF" BorderThickness="1" CornerRadius="3"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M2,7 L6,11 L14,2" Stroke="#2DD4FF"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stretch="Uniform" Margin="2" Visibility="Collapsed" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Poignée de glisser-déposer pour réordonner les lignes, visible
             uniquement en mode "déplacer" (déverrouillé) — voir
             RowDragHandle_PreviewMouseLeftButtonDown/RowDragHandle_MouseMove/
             RowDragHandle_MouseLeftButtonUp (OverlayWindow.xaml.cs), câblés
             au constructeur pour MouseMove/MouseLeftButtonUp (identiques sur
             les 9 poignées) et ici en XAML pour l'évènement de démarrage. -->
        <Style x:Key="OverlayRowDragHandleStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="16" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#802DD4FF" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Pastille de couleur de texte par ligne, visible uniquement en
             mode "déplacer" (déverrouillé) comme la case à cocher et la
             poignée — voir RowColorSwatch_Click/ApplyRowTextColor
             (OverlayWindow.xaml.cs). Le fond (couleur RÉELLEMENT affichée
             pour cette ligne, personnalisée ou globale) est posé par code ;
             ce style ne fixe que la taille/le contour + la zone cliquable
             (comme OverlayRowCheckboxStyle, un gabarit 20x20 plus grand que
             la pastille visible 14x14, pour ne pas rater le clic). -->
        <Style x:Key="OverlayRowColorSwatchStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border Width="14" Height="14" CornerRadius="7"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#802DD4FF" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Échelle de l'overlay (Réglages > ⬡ NovaVox > Apparence, curseur
             "Taille de l'overlay" -> OverlayWindow.ApplyScale) : un
             LayoutTransform, PAS un RenderTransform, pour que le texte se
             redessine net à la taille finale (pas d'agrandissement flou de
             pixels déjà rendus) et que la fenêtre (SizeToContent=
             "WidthAndHeight", voir plus haut) recalcule sa taille réelle
             une fois le contenu mis à l'échelle — Width="230" reste sur
             PanelBorder ci-dessous (taille de CONCEPTION à l'échelle 1.0),
             plus sur la Window elle-même. -->
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="OverlayScaleTransform" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Border x:Name="PanelBorder"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="#592DD4FF"
                Padding="12,10">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="18" ShadowDepth="4" Direction="270" />
            </Border.Effect>
            <!-- Colonnes de l'overlay (glisser une ligne horizontalement en
                 mode édition pour la faire passer d'une colonne à l'autre,
                 verticalement pour la réordonner dedans — voir
                 OverlayWindow.ApplyLayout/RowDragHandle_MouseMove). 9
                 colonnes déclarées à l'avance (OverlayConfig.MaxColumns =
                 RowKeys.Length, une par ligne existante — permet de toutes
                 les mettre côte à côte si voulu) : AUCUNE largeur fixe, une
                 colonne se dimensionne à son propre contenu (largeur nulle
                 si vide) — l'overlay rétrécit donc réellement quand une
                 colonne se vide, et ne s'élargit que si une ligne y est
                 réellement glissée. Une colonne vide n'apparaît en mode
                 édition que comme une fine bande cliquable (largeur/marge
                 gérées en code, voir RefreshColumnEditingStrips) servant de
                 zone de dépôt pour y glisser une première ligne. Toutes les
                 lignes restent déclarées ici dans Column0 (comportement par
                 défaut à une seule colonne) ; le code les redistribue selon
                 la config enregistrée. -->
            <StackPanel x:Name="ColumnsPanel" Orientation="Horizontal">
                <StackPanel x:Name="Column0">
                <Grid x:Name="RowTime" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TimeDragHandle" Grid.Column="0" Text="⠿" Tag="time" Style="{StaticResource OverlayRowDragHandleStyle}"
                               PreviewMouseLeftButtonDown="RowDragHandle_PreviewMouseLeftButtonDown" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="🕐" Width="16" TextAlignment="Center" />
                        <TextBlock x:Name="TimeValue" Text="--:--:--" Margin="6,0,0,0" FontWeight="SemiBold" Foreground="#DBE4EE" />
                    </StackPanel>
                    <Button x:Name="TimeColorSwatch" Grid.Column="2" Tag="time" Style="{StaticResource OverlayRowColorSwatchStyle}" VerticalAlignment="Center" Click="RowColorSwatch_Click" />
                    <CheckBox x:Name="TimeRowCheckbox" Grid.Column="3" Tag="time" Style="{StaticResource OverlayRowCheckboxStyle}"
                              VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                              Checked="RowVisibilityCheckbox_Changed" Unchecked="RowVisibilityCheckbox_Changed" />
                </Grid>
                <Grid x:Name="RowListening" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ListeningDragHandle" Grid.Column="0" Text="⠿" Tag="listening" Style="{StaticResource OverlayRowDragHandleStyle}"
                               PreviewMouseLeftButtonDown="RowDragHandle_PreviewMouseLeftButtonDown" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="🎧" Width="16" TextAlignment="Center" />
                        <TextBlock x:Name="ListeningLabel" Text="Écoute :" Margin="6,0,4,0" Foreground="#DBE4EE" />
                        <TextBlock x:Name="ListeningValue" Text="Arrêtée" Foreground="#DBE4EE" />
                    </StackPanel>
                    <Button x:Name="ListeningColorSwatch" Grid.Column="2" Tag="listening" Style="{StaticResource OverlayRowColorSwatchStyle}" VerticalAlignment="Center" Click="RowColorSwatch_Click" />
                    <CheckBox x:Name="ListeningRowCheckbox" Grid.Column="3" Tag="listening" Style="{StaticResource OverlayRowCheckboxStyle}"
                              VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                              Checked="RowVisibilityCheckbox_Changed" Unchecked="RowVisibilityCheckbox_Changed" />
                </Grid>
                <Grid x:Name="RowMic" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MicDragHandle" Grid.Column="0" Text="⠿" Tag="mic" Style="{StaticResource OverlayRowDragHandleStyle}"
                               PreviewMouseLeftButtonDown="RowDragHandle_PreviewMouseLeftButtonDown" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="🎙" Width="16" TextAlignment="Center" />
                        <TextBlock x:Name="MicLabel" Text="Micro :" Margin="6,0,4,0" Foreground="#DBE4EE" />
                        <TextBlock x:Name="MicValue" Text="—" Foreground="#DBE4EE" />
                    </StackPanel>
                    <Button x:Name="MicColorSwatch" Grid.Column="2" Tag="mic" Style="{StaticResource OverlayRowColorSwatchStyle}" VerticalAlignment="Center" Click="RowColorSwatch_Click" />
                    <CheckBox x:Name="MicRowCheckbox" Grid.Column="3" Tag="mic" Style="{StaticResource OverlayRowCheckboxStyle}"
                              VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                              Checked="RowVisibilityCheckbox_Changed" Unchecked="RowVisibilityCheckbox_Changed" />
                </Grid>
                <Grid x:Name="RowPhrase" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PhraseDragHandle" Grid.Column="0" Text="⠿" Tag="phrase" Style="{StaticResource OverlayRowDragHandleStyle}"
                               PreviewMouseLeftButtonDown="RowDragHandle_PreviewMouseLeftButtonDown" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="💬" Width="16" TextAlignment="Center" />
                        <TextBlock x:Name="PhraseValue" Text="…" Margin="6,0,0,0" Foreground="#DBE4EE"
                                   TextTrimming="CharacterEllipsis" MaxWidth="150" />
                    </StackPanel>
                    <Button x:Name="PhraseColorSwatch" Grid.Column="2" Tag="phrase" Style="{StaticResource OverlayRowColorSwatchStyle}" VerticalAlignment="Center" Click="RowColorSwatch_Click" />
                    <CheckBox x:Name="PhraseRowCheckbox" Grid.Column="3" Tag="phrase" Style="{StaticResource OverlayRowCheckboxStyle}"
                              VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                              Checked="RowVisibilityCheckbox_Changed" Unchecked="RowVisibilityCheckbox_Changed" />
                </Grid>
                <Grid x:Name="RowZone" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ZoneDragHandle" Grid.Column="0" Text="⠿" Tag="zone" Style="{StaticResource OverlayRowDragHandleStyle}"
                               PreviewMouseLeftButtonDown="RowDragHandle_PreviewMouseLeftButtonDown" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="🧭" Width="16" TextAlignment="Center" />
                        <TextBlock x:Name="ZoneLabel" Text="Zone :" Margin="6,0,4,0" Foreground="#DBE4EE" />
                        <TextBlock x:Name="ZoneValue" Text="—" Foreground="#DBE4EE"
                                   TextTrimming="CharacterEllipsis" MaxWidth="120" />
                    </StackPanel>
                    <Button x:Name="ZoneColorSwatch" Grid.Column="2" Tag="zone" Style="{StaticResource OverlayRowColorSwatchStyle}" VerticalAlignment="Center" Click="RowColorSwatch_Click" />
                    <CheckBox x:Name="ZoneRowCheckbox" Grid.Column="3" Tag="zone" Style="{StaticResource OverlayRowCheckboxStyle}"
                              VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                              Checked="RowVisibilityCheckbox_Changed" Unchecked="RowVisibilityCheckbox_Changed" />
                </Grid>
                <Grid x:Name="RowArmistice" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ArmisticeDragHandle" Grid.Column="0" Text="⠿" Tag="armistice" Style="{StaticResource OverlayRowDragHandleStyle}"
                               PreviewMouseLeftButtonDown="RowDragHandle_PreviewMouseLeftButtonDown" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- Icône basculée par code (SetArmistice) : 🚫 en zone
                             d'armistice (combat interdit), ⚔ sinon — voir le
                             commentaire sur ArmisticeEnteredRegex/ArmisticeLeftRegex
                             (GameLogAnnouncer.cs) pour la détection. Symbole
                             Unicode générique, pas une icône extraite du jeu
                             (voir la réponse donnée à l'utilisateur sur ce point). -->
                        <TextBlock x:Name="ArmisticeIcon" Text="⚔" Width="16" TextAlignment="Center" />
                        <TextBlock x:Name="ArmisticeLabel" Text="Armistice :" Margin="6,0,4,0" Foreground="#DBE4EE" />
                        <TextBlock x:Name="ArmisticeValue" Text="—" Foreground="#DBE4EE" />
                    </StackPanel>
                    <Button x:Name="ArmisticeColorSwatch" Grid.Column="2" Tag="armistice" Style="{StaticResource OverlayRowColorSwatchStyle}" VerticalAlignment="Center" Click="RowColorSwatch_Click" />
                    <CheckBox x:Name="ArmisticeRowCheckbox" Grid.Column="3" Tag="armistice" Style="{StaticResource OverlayRowCheckboxStyle}"
                              VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                              Checked="RowVisibilityCheckbox_Changed" Unchecked="RowVisibilityCheckbox_Changed" />
                </Grid>
                <Grid x:Name="RowJuridiction" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="JuridictionDragHandle" Grid.Column="0" Text="⠿" Tag="juridiction" Style="{StaticResource OverlayRowDragHandleStyle}"
                               PreviewMouseLeftButtonDown="RowDragHandle_PreviewMouseLeftButtonDown" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="⚖" Width="16" TextAlignment="Center" />
                        <TextBlock x:Name="JuridictionLabel" Text="Juridiction :" Margin="6,0,4,0" Foreground="#DBE4EE" />
                        <TextBlock x:Name="JuridictionValue" Text="—" Foreground="#DBE4EE"
                                   TextTrimming="CharacterEllipsis" MaxWidth="120" />
                    </StackPanel>
                    <Button x:Name="JuridictionColorSwatch" Grid.Column="2" Tag="juridiction" Style="{StaticResource OverlayRowColorSwatchStyle}" VerticalAlignment="Center" Click="RowColorSwatch_Click" />
                    <CheckBox x:Name="JuridictionRowCheckbox" Grid.Column="3" Tag="juridiction" Style="{StaticResource OverlayRowCheckboxStyle}"
                              VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                              Checked="RowVisibilityCheckbox_Changed" Unchecked="RowVisibilityCheckbox_Changed" />
                </Grid>
                <Grid x:Name="RowLastCmd" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LastCmdDragHandle" Grid.Column="0" Text="⠿" Tag="lastCmd" Style="{StaticResource OverlayRowDragHandleStyle}"
                               PreviewMouseLeftButtonDown="RowDragHandle_PreviewMouseLeftButtonDown" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="🎮" Width="16" TextAlignment="Center" />
                        <TextBlock x:Name="LastCmdValue" Text="—" Margin="6,0,0,0" Foreground="#DBE4EE"
                                   TextTrimming="CharacterEllipsis" MaxWidth="150" />
                    </StackPanel>
                    <Button x:Name="LastCmdColorSwatch" Grid.Column="2" Tag="lastCmd" Style="{StaticResource OverlayRowColorSwatchStyle}" VerticalAlignment="Center" Click="RowColorSwatch_Click" />
                    <CheckBox x:Name="LastCmdRowCheckbox" Grid.Column="3" Tag="lastCmd" Style="{StaticResource OverlayRowCheckboxStyle}"
                              VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                              Checked="RowVisibilityCheckbox_Changed" Unchecked="RowVisibilityCheckbox_Changed" />
                </Grid>
                <Grid x:Name="RowShipSheet">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ShipSheetDragHandle" Grid.Column="0" Text="⠿" Tag="shipSheet" VerticalAlignment="Top"
                               Style="{StaticResource OverlayRowDragHandleStyle}"
                               PreviewMouseLeftButtonDown="RowDragHandle_PreviewMouseLeftButtonDown" />
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀" Width="16" TextAlignment="Center" />
                            <TextBlock x:Name="ShipSheetTitle" Text="Aucun vaisseau sélectionné" Margin="6,0,0,0" FontWeight="SemiBold" Foreground="#DBE4EE" />
                        </StackPanel>
                        <!-- Liée à une IReadOnlyList&lt;ShipSheetPoint&gt; (voir
                             OverlayWindow.xaml.cs SetShipSheet) : le libellé du repère
                             prend SA PROPRE couleur (réglable indépendamment par repère
                             dans Réglages > 🚀 Vaisseaux, HexColorToBrush défini dans
                             App.xaml), la description reste en gris neutre — sur sa
                             PROPRE ligne (LineBreak) plutôt qu'à la suite sur la même
                             ligne, plus lisible pour une description un peu longue dans
                             la largeur étroite de l'overlay (MaxWidth). -->
                        <ItemsControl x:Name="ShipSheetPointsList" Margin="22,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,4,0,0" Foreground="#DBE4EE" TextWrapping="Wrap" MaxWidth="180">
                                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" Foreground="{Binding Color, Mode=OneWay, Converter={StaticResource HexColorToBrush}}" /><LineBreak /><Run Text="{Binding Description, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Button x:Name="ShipSheetColorSwatch" Grid.Column="2" Tag="shipSheet" Style="{StaticResource OverlayRowColorSwatchStyle}" VerticalAlignment="Top" Click="RowColorSwatch_Click" />
                    <CheckBox x:Name="ShipSheetRowCheckbox" Grid.Column="3" Tag="shipSheet" Style="{StaticResource OverlayRowCheckboxStyle}"
                              VerticalAlignment="Top" Margin="8,0,0,0" Visibility="Collapsed"
                              Checked="RowVisibilityCheckbox_Changed" Unchecked="RowVisibilityCheckbox_Changed" />
                </Grid>
                </StackPanel>
                <StackPanel x:Name="Column1" />
                <StackPanel x:Name="Column2" />
                <StackPanel x:Name="Column3" />
                <StackPanel x:Name="Column4" />
                <StackPanel x:Name="Column5" />
                <StackPanel x:Name="Column6" />
                <StackPanel x:Name="Column7" />
                <StackPanel x:Name="Column8" />
            </StackPanel>
        </Border>

        <!-- Flash vert (2s) à chaque commande déclenchée, sur son propre calque
             pour ne jamais entrer en conflit avec le fond "micro coupé" — voir
             #panel::after / #panel.cmd-flash (overlay.html). -->
        <Border x:Name="FlashOverlay" CornerRadius="10" Background="#8C0C5E31" Opacity="0" IsHitTestVisible="False" />

        <!-- Sélecteur de couleur de texte PAR LIGNE (une pastille par ligne,
             un seul popup partagé — voir RowColorSwatch_Click,
             OverlayWindow.xaml.cs) : mini version, couleurs codées en dur
             (cette fenêtre ne fusionne pas Theme.xaml, voir plus haut) du
             sélecteur de MainWindow.xaml (ColorPickerPopup) — mêmes sliders
             RVB + case hex, sans la grille de préréglages (moins de place
             disponible dans l'overlay, et l'essentiel est déjà couvert par
             les sliders/le hex). Bouton "Rétablir" en plus : une ligne SANS
             couleur personnalisée suit la couleur globale de l'overlay
             (Réglages > 🖥 Overlay), donc il faut un moyen d'y revenir. -->
        <Popup x:Name="RowColorPickerPopup" StaysOpen="False" AllowsTransparency="True"
               Placement="Bottom" PopupAnimation="Fade">
            <Border Background="#0a0e14" BorderBrush="#2DD4FF" BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel Width="180">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="RowColorPickerPreview" Width="30" Height="30" CornerRadius="4"
                                BorderBrush="#592DD4FF" BorderThickness="1" />
                        <TextBox x:Name="RowColorPickerHexBox" Width="90" Margin="8,0,0,0" VerticalAlignment="Center"
                                 LostFocus="RowColorPickerHexBox_LostFocus" />
                    </StackPanel>
                    <TextBlock Text="Rouge" Foreground="#802DD4FF" FontSize="11" Margin="0,8,0,2" />
                    <Slider x:Name="RowColorPickerRSlider" Minimum="0" Maximum="255" ValueChanged="RowColorPickerSlider_Changed" />
                    <TextBlock Text="Vert" Foreground="#802DD4FF" FontSize="11" Margin="0,4,0,2" />
                    <Slider x:Name="RowColorPickerGSlider" Minimum="0" Maximum="255" ValueChanged="RowColorPickerSlider_Changed" />
                    <TextBlock Text="Bleu" Foreground="#802DD4FF" FontSize="11" Margin="0,4,0,2" />
                    <Slider x:Name="RowColorPickerBSlider" Minimum="0" Maximum="255" ValueChanged="RowColorPickerSlider_Changed" />
                    <Button Content="Rétablir la couleur par défaut" Margin="0,10,0,0" Click="RowColorPickerReset_Click" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
