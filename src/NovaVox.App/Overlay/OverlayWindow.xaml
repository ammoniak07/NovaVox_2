<Window x:Class="NovaVox.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NovaVox Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="230">
    <Window.Resources>
        <!-- Case à cocher compacte pour choisir les lignes affichées, visible
             uniquement en mode "déplacer" (déverrouillé) — voir SetEditMode/
             RefreshRowVisualsForEditMode. Style minimal indépendant de
             Theme.xaml (cette fenêtre ne le fusionne pas), coloré comme le
             reste de l'overlay (cyan d'accent, texte clair). -->
        <Style x:Key="OverlayRowCheckboxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <!-- La case visible ne fait que 14x14, mais la zone cliquable réelle
                 est celle du Grid racine du template (Background="Transparent"
                 explicite pour être hit-testable partout, pas seulement là où
                 quelque chose est dessiné) : 24x24, sinon un clic à quelques
                 pixels de la case rate sa cible et retombe sur le panneau
                 derrière, ce qui déclenche un déplacement de l'overlay au lieu
                 de cocher/décocher. -->
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="Box" Width="14" Height="14" Background="#33FFFFFF"
                                    BorderBrush="#2DD4FF" BorderThickness="1" CornerRadius="3"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M2,7 L6,11 L14,2" Stroke="#2DD4FF"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stretch="Uniform" Margin="2" Visibility="Collapsed" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="PanelBorder"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="#592DD4FF"
                Padding="12,10">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.45" BlurRadius="18" ShadowDepth="4" Direction="270" />
            </Border.Effect>
            <StackPanel>
                <Grid x:Name="RowTime" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="🕐" Width="16" TextAlignment="Center" />
                        <TextBlock x:Name="TimeValue" Text="--:--:--" Margin="6,0,0,0" FontWeight="SemiBold" Foreground="#DBE4EE" />
                    </StackPanel>
                    <CheckBox x:Name="TimeRowCheckbox" Grid.Column="1" Tag="time" Style="{StaticResource OverlayRowCheckboxStyle}"
                              VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                              Checked="RowVisibilityCheckbox_Changed" Unchecked="RowVisibilityCheckbox_Changed" />
                </Grid>
                <Grid x:Name="RowListening" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="🎧" Width="16" TextAlignment="Center" />
                        <TextBlock x:Name="ListeningLabel" Text="Écoute :" Margin="6,0,4,0" Foreground="#DBE4EE" />
                        <TextBlock x:Name="ListeningValue" Text="Arrêtée" Foreground="#DBE4EE" />
                    </StackPanel>
                    <CheckBox x:Name="ListeningRowCheckbox" Grid.Column="1" Tag="listening" Style="{StaticResource OverlayRowCheckboxStyle}"
                              VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                              Checked="RowVisibilityCheckbox_Changed" Unchecked="RowVisibilityCheckbox_Changed" />
                </Grid>
                <Grid x:Name="RowMic" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="🎙" Width="16" TextAlignment="Center" />
                        <TextBlock x:Name="MicLabel" Text="Micro :" Margin="6,0,4,0" Foreground="#DBE4EE" />
                        <TextBlock x:Name="MicValue" Text="—" Foreground="#DBE4EE" />
                    </StackPanel>
                    <CheckBox x:Name="MicRowCheckbox" Grid.Column="1" Tag="mic" Style="{StaticResource OverlayRowCheckboxStyle}"
                              VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                              Checked="RowVisibilityCheckbox_Changed" Unchecked="RowVisibilityCheckbox_Changed" />
                </Grid>
                <Grid x:Name="RowPhrase" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="💬" Width="16" TextAlignment="Center" />
                        <TextBlock x:Name="PhraseValue" Text="…" Margin="6,0,0,0" Foreground="#DBE4EE"
                                   TextTrimming="CharacterEllipsis" MaxWidth="150" />
                    </StackPanel>
                    <CheckBox x:Name="PhraseRowCheckbox" Grid.Column="1" Tag="phrase" Style="{StaticResource OverlayRowCheckboxStyle}"
                              VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                              Checked="RowVisibilityCheckbox_Changed" Unchecked="RowVisibilityCheckbox_Changed" />
                </Grid>
                <Grid x:Name="RowZone" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="🧭" Width="16" TextAlignment="Center" />
                        <TextBlock x:Name="ZoneLabel" Text="Zone :" Margin="6,0,4,0" Foreground="#DBE4EE" />
                        <TextBlock x:Name="ZoneValue" Text="—" Foreground="#DBE4EE"
                                   TextTrimming="CharacterEllipsis" MaxWidth="120" />
                    </StackPanel>
                    <CheckBox x:Name="ZoneRowCheckbox" Grid.Column="1" Tag="zone" Style="{StaticResource OverlayRowCheckboxStyle}"
                              VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                              Checked="RowVisibilityCheckbox_Changed" Unchecked="RowVisibilityCheckbox_Changed" />
                </Grid>
                <Grid x:Name="RowLastCmd" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="🎮" Width="16" TextAlignment="Center" />
                        <TextBlock x:Name="LastCmdValue" Text="—" Margin="6,0,0,0" Foreground="#DBE4EE"
                                   TextTrimming="CharacterEllipsis" MaxWidth="150" />
                    </StackPanel>
                    <CheckBox x:Name="LastCmdRowCheckbox" Grid.Column="1" Tag="lastCmd" Style="{StaticResource OverlayRowCheckboxStyle}"
                              VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                              Checked="RowVisibilityCheckbox_Changed" Unchecked="RowVisibilityCheckbox_Changed" />
                </Grid>
                <Grid x:Name="RowShipSheet">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀" Width="16" TextAlignment="Center" />
                            <TextBlock x:Name="ShipSheetTitle" Text="Aucun vaisseau sélectionné" Margin="6,0,0,0" FontWeight="SemiBold" Foreground="#DBE4EE" />
                        </StackPanel>
                        <!-- Liée directement à un Dictionary&lt;string,string&gt; (repère -> description,
                             voir OverlayWindow.xaml.cs SetShipSheet) : {Binding Key}/{Binding Value}
                             fonctionnent tels quels sur les KeyValuePair énumérés. -->
                        <ItemsControl x:Name="ShipSheetPointsList" Margin="22,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2,0,0" Foreground="#DBE4EE" TextWrapping="Wrap" MaxWidth="180">
                                        <Run Text="{Binding Key, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" : " /><Run Text="{Binding Value, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <CheckBox x:Name="ShipSheetRowCheckbox" Grid.Column="1" Tag="shipSheet" Style="{StaticResource OverlayRowCheckboxStyle}"
                              VerticalAlignment="Top" Margin="8,0,0,0" Visibility="Collapsed"
                              Checked="RowVisibilityCheckbox_Changed" Unchecked="RowVisibilityCheckbox_Changed" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Flash vert (2s) à chaque commande déclenchée, sur son propre calque
             pour ne jamais entrer en conflit avec le fond "micro coupé" — voir
             #panel::after / #panel.cmd-flash (overlay.html). -->
        <Border x:Name="FlashOverlay" CornerRadius="10" Background="#8C0C5E31" Opacity="0" IsHitTestVisible="False" />
    </Grid>
</Window>
