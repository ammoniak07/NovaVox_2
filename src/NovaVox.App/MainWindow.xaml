            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                    Width="1000" MaxHeight="880" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CHOISIR LA OU LES TOUCHES" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="✕" Width="28" Height="28" Padding="0" FontSize="13" Click="CloseKeyboard_Click" />
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SÉLECTION : " Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock x:Name="KbSelectedValueText" Grid.Column="1" Text="—" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <Button x:Name="KbCaptureButton" Grid.Column="2" Content="🎙 Détecter (appuyer sur la touche)" Click="KbCaptureButton_Click" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="DISPOSITION : " Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Button x:Name="KbLayoutFrButton" Content="AZERTY France" Tag="azerty_fr" Click="KbLayoutButton_Click" Margin="0,0,6,0" />
                        <Button x:Name="KbLayoutBeButton" Content="AZERTY Belgique" Tag="azerty_be" Click="KbLayoutButton_Click" Margin="0,0,6,0" />
                        <Button x:Name="KbLayoutQwertyButton" Content="QWERTY" Tag="qwerty" Click="KbLayoutButton_Click" />
                        <TextBlock Text="Change juste l'affichage des lettres pour correspondre à ton clavier physique — les touches réellement envoyées au jeu ne changent pas."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="360" />
                    </StackPanel>

                    <CheckBox x:Name="KbHoldCheckbox" Grid.Row="3" Content="Maintenir la touche 2 secondes (au lieu d'un appui bref)" Margin="0,0,0,8" />

                    <StackPanel x:Name="KbRepeatSection" Grid.Row="4" Margin="0,0,0,10">
                        <CheckBox x:Name="KbRepeatCheckbox" Content="Répéter la touche plusieurs fois" Checked="KbRepeatCheckbox_Changed" Unchecked="KbRepeatCheckbox_Changed" />
                        <StackPanel x:Name="KbRepeatFields" Orientation="Horizontal" Margin="20,6,0,0" Visibility="Collapsed">
                            <TextBlock Text="Répétitions :" VerticalAlignment="Center" />
                            <TextBox x:Name="KbRepeatCountBox" Width="50" Margin="6,0,16,0" />
                            <TextBlock Text="Délai entre chaque (s) :" VerticalAlignment="Center" />
                            <TextBox x:Name="KbRepeatDelayBox" Width="50" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel x:Name="KbMainPanel" />
                                <StackPanel Margin="18,0,0,0">
                                    <StackPanel x:Name="KbNavPanel" />
                                    <StackPanel x:Name="KbNumpadPanel" Margin="0,14,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="SOURIS" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,16,0,6" />
                            <StackPanel x:Name="KbMousePanel" Orientation="Horizontal" Margin="0,0,0,8" />
                            <Button x:Name="KbMouseCaptureButton" Content="🖱 Détecter (cliquer)" HorizontalAlignment="Stretch" Click="KbMouseCaptureButton_Click" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="6" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Effacer" Click="KbClear_Click" />
                        <Button x:Name="KbCancelButton" Grid.Column="2" Content="Annuler" Click="KbCancel_Click" Margin="0,0,6,0" />
                        <Button x:Name="KbConfirmButton" Grid.Column="3" Content="Valider" Style="{StaticResource AccentPillButtonStyle}" Click="KbConfirm_Click" IsEnabled="False" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- Recouvrement "Notes de mise à jour", ouvert en cliquant sur le numéro de version du pied de page -->
        <Border x:Name="PatchNotesOverlay" Background="#B3000000" Visibility="Collapsed">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                    Width="640" MaxHeight="720" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,16,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📰 Notes de mise à jour" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="✕" Width="28" Height="28" Padding="0" FontSize="13" Click="ClosePatchNotes_Click" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="16,4,16,16" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PatchNotesContent" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <!-- Notification "mise à jour disponible" : contrairement aux recouvrements
             ci-dessus (SettingsOverlay...), pas de fond semi-transparent plein écran,
             juste une carte flottante en haut à droite qui n'empêche jamais
             d'utiliser le reste de la fenêtre pendant qu'elle est affichée. Montrée
             par ShowUpdateToast (MainWindow.xaml.cs), appelée après la vérification
             automatique au démarrage et après un clic manuel sur "Vérifier les mises
             à jour" s'il y a effectivement une nouvelle version. -->
        <Border x:Name="UpdateToast" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,16,16,0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,10" Panel.ZIndex="1000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4" Color="Black" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔔" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource AmberBrush}" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Nouvelle édition de NovaVox disponible" FontWeight="Bold" FontSize="13" />
                    <TextBlock x:Name="UpdateToastSubText" Text="(.NET/WPF) : v0.0.0" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <Button x:Name="UpdateToastDownloadButton" Content="Télécharger" Style="{StaticResource AccentPillButtonStyle}"
                        Padding="14,6" Margin="18,0,0,0" Click="UpdateToastDownload_Click" />
                <Button Style="{StaticResource IconCircleButtonStyle}" Width="26" Height="26" Padding="0" FontSize="11" Content="✕"
                        Margin="8,0,0,0" Click="UpdateToastClose_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
