                                <TextBlock><Hyperlink NavigateUri="https://github.com/rhasspy/piper" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/rhasspy/piper</Hyperlink></TextBlock>
                                <TextBlock Text="NAudio — lecture/capture audio" Margin="0,10,0,0" />
                                <TextBlock><Hyperlink NavigateUri="https://github.com/naudio/NAudio" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/naudio/NAudio</Hyperlink></TextBlock>
                                <TextBlock Text="Vortice.Windows — accès aux manettes (DirectInput)" Margin="0,10,0,0" />
                                <TextBlock><Hyperlink NavigateUri="https://github.com/amerkoleci/Vortice.Windows" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/amerkoleci/Vortice.Windows</Hyperlink></TextBlock>
                                <TextBlock Text="Hardcodet.NotifyIcon.Wpf — icône dans la zone de notification" Margin="0,10,0,0" />
                                <TextBlock><Hyperlink NavigateUri="https://github.com/hardcodet/wpf-notifyicon" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/hardcodet/wpf-notifyicon</Hyperlink></TextBlock>
