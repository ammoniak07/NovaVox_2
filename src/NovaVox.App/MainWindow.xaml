                                                                     Content="{Binding Label}" IsEnabled="{Binding IsInstalled}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Content="Télécharger" Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}" Click="DownloadPiperVoice_Click" />
                                                        <Button Content="Supprimer" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}" Click="DeletePiperVoice_Click" Margin="6,0,0,0" />
                                                        <Button Content="Tester" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}" Click="TestPiperVoice_Click" Margin="6,0,0,0" />
                                                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Vitesse (length_scale)" Margin="0,16,0,0" />
                                <Slider x:Name="PiperLengthScaleSlider" Minimum="0.5" Maximum="2.0" ValueChanged="PiperLengthScaleSlider_ValueChanged" />
                                <TextBlock Text="Expressivité (noise_scale)" />
                                <Slider x:Name="PiperNoiseScaleSlider" Minimum="0.0" Maximum="1.5" ValueChanged="PiperNoiseScaleSlider_ValueChanged" />
                            </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="GameLogSettingsTab" Header="🛰 Game.log">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="GameLogEnabledCheckbox" Content="Surveiller le Game.log" Checked="GameLogEnabledCheckbox_Changed" Unchecked="GameLogEnabledCheckbox_Changed" />
                                <CheckBox x:Name="GameLogAnnounceCheckbox" Content="Annoncer les changements de zone à voix haute" Margin="0,8,0,0"
                                          Checked="GameLogAnnounceCheckbox_Changed" Unchecked="GameLogAnnounceCheckbox_Changed" />
                                <TextBlock Text="Pseudo RSI" Margin="0,16,0,4" />
                                <TextBox x:Name="PlayerHandleBox" LostFocus="PlayerHandleBox_LostFocus" />
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="⬡ NovaVox">
                            <StackPanel Margin="10">
                                <TextBlock Text="Overlay en jeu" FontWeight="Bold" Margin="0,0,0,6" />
                                <CheckBox x:Name="OverlayEnabledCheckbox" Content="Activer l'overlay" Checked="OverlayEnabledCheckbox_Changed" Unchecked="OverlayEnabledCheckbox_Changed" />
                                <Button x:Name="ToggleOverlayEditButton" Content="Déplacer l'overlay" Margin="0,8,0,0" HorizontalAlignment="Left" Click="ToggleOverlayEditButton_Click" />

                                <TextBlock Text="Apparence" Margin="0,16,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Fond :" VerticalAlignment="Center" />
                                    <TextBox x:Name="OverlayBgColorBox" Width="90" Margin="6,0" LostFocus="OverlayAppearance_Changed" />
                                    <TextBlock Text="Opacité :" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <Slider x:Name="OverlayBgOpacitySlider" Minimum="0" Maximum="100" Width="100" Margin="6,0" ValueChanged="OverlayAppearance_Changed" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Texte :" VerticalAlignment="Center" />
                                    <TextBox x:Name="OverlayTextColorBox" Width="90" Margin="6,0" LostFocus="OverlayAppearance_Changed" />
                                    <TextBlock Text="Opacité :" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <Slider x:Name="OverlayTextOpacitySlider" Minimum="0" Maximum="100" Width="100" Margin="6,0" ValueChanged="OverlayAppearance_Changed" />
                                </StackPanel>

                                <CheckBox x:Name="AutolaunchCheckbox" Content="Lancer NovaVox automatiquement au démarrage de Star Citizen"
                                          Margin="0,16,0,0" Checked="AutolaunchCheckbox_Changed" Unchecked="AutolaunchCheckbox_Changed" />

                                <TextBlock Text="Langue de l'interface" FontWeight="Bold" Margin="0,16,0,6" />
                                <ComboBox x:Name="UiLanguageCombo" SelectionChanged="UiLanguageCombo_SelectionChanged">
                                    <ComboBoxItem Content="Français" Tag="fr" />
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="Nederlands" Tag="nl" />
                                    <ComboBoxItem Content="Español" Tag="es" />
                                    <ComboBoxItem Content="Italiano" Tag="it" />
                                    <ComboBoxItem Content="Deutsch" Tag="de" />
                                </ComboBox>

                                <Button Content="Réinitialiser l'application" Margin="0,24,0,0" HorizontalAlignment="Left" Click="ResetApplication_Click" />

                                <TextBlock Text="Configuration" FontWeight="Bold" Margin="0,24,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Exporter la config" Click="ExportConfig_Click" />
                                    <Button Content="Exporter (avec tous les profils)" Margin="8,0,0,0" Click="ExportConfigAllProfiles_Click" />
                                </StackPanel>
                                <Button Content="Importer la config" Margin="0,6,0,0" HorizontalAlignment="Left" Click="ImportConfig_Click" />

                                <TextBlock Text="Mise à jour" FontWeight="Bold" Margin="0,24,0,6" />
                                <Button Content="Vérifier les mises à jour" HorizontalAlignment="Left" IsEnabled="False" Click="CheckForUpdate_Click"
                                        ToolTip="En suspens : ce bouton pointe encore vers le serveur de mise à jour de l'ancienne version Python de NovaVox." />
                                <TextBlock Text="En suspens pour le moment (le serveur de mise à jour actuel est celui de l'ancienne version Python)."
                                           Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="UpdateStatusText" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="🙏 Crédits">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <TextBlock x:Name="VersionText" Text="NovaVox" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="Développé par Ammoniak007" Margin="0,8,0,0" />
                                <TextBlock Text="Discord : NovaVox" Margin="0,4,0,0" />
                                <TextBlock Margin="0,4,0,0"><Hyperlink NavigateUri="https://discord.gg/NhhhGKv7F" RequestNavigate="Hyperlink_RequestNavigate">https://discord.gg/NhhhGKv7F</Hyperlink></TextBlock>

                                <TextBlock Text="Bibliothèques utilisées" FontWeight="Bold" Margin="0,24,0,6" />
                                <TextBlock Text="Vosk — reconnaissance vocale hors-ligne" Margin="0,6,0,0" />
                                <TextBlock><Hyperlink NavigateUri="https://github.com/alphacep/vosk-api" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/alphacep/vosk-api</Hyperlink></TextBlock>
                                <TextBlock Text="Piper — synthèse vocale (TTS)" Margin="0,10,0,0" />
                                <TextBlock><Hyperlink NavigateUri="https://github.com/rhasspy/piper" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/rhasspy/piper</Hyperlink></TextBlock>
                                <TextBlock Text="NAudio — lecture/capture audio" Margin="0,10,0,0" />
                                <TextBlock><Hyperlink NavigateUri="https://github.com/naudio/NAudio" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/naudio/NAudio</Hyperlink></TextBlock>
                                <TextBlock Text="Vortice.Windows — accès aux manettes (DirectInput)" Margin="0,10,0,0" />
                                <TextBlock><Hyperlink NavigateUri="https://github.com/amerkoleci/Vortice.Windows" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/amerkoleci/Vortice.Windows</Hyperlink></TextBlock>
                                <TextBlock Text="Hardcodet.NotifyIcon.Wpf — icône dans la zone de notification" Margin="0,10,0,0" />
                                <TextBlock><Hyperlink NavigateUri="https://github.com/hardcodet/wpf-notifyicon" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/hardcodet/wpf-notifyicon</Hyperlink></TextBlock>
                                <TextBlock Text="System.Drawing.Common" Margin="0,10,0,0" />
                                <TextBlock><Hyperlink NavigateUri="https://www.nuget.org/packages/System.Drawing.Common" RequestNavigate="Hyperlink_RequestNavigate">https://www.nuget.org/packages/System.Drawing.Common</Hyperlink></TextBlock>
                            </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Border>

        <!-- Recouvrement "Assistant Gemini" (discussion) — fenêtre d'UTILISATION, distincte des réglages -->
        <Border x:Name="GeminiOverlay" Background="#B3000000" Visibility="Collapsed">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                    Width="560" MaxHeight="700" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🌟 Assistant Gemini" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="✕" Width="28" Height="28" Padding="0" FontSize="13" Click="CloseGeminiChat_Click" />
                    </Grid>

                    <TextBlock x:Name="GeminiWakeHintText" Grid.Row="1" Margin="0,6,0,10" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />

                    <Border Grid.Row="2" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <ScrollViewer x:Name="GeminiChatScrollViewer" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="GeminiChatList" Margin="10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,4" Padding="10,6" CornerRadius="6" MaxWidth="420">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="user">
                                                            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Role}" Value="error">
                                                            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="error">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="GeminiChatInput" Width="360" KeyDown="GeminiChatInput_KeyDown" />
                            <CheckBox x:Name="GeminiSpeakCheckbox" Content="🔊" IsChecked="True" Margin="8,0,0,0" VerticalAlignment="Center"
                                      ToolTip="Lire la réponse à voix haute" />
                            <Button Content="Envoyer" Style="{StaticResource AccentPillButtonStyle}" Margin="8,0,0,0" Click="GeminiSend_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Recouvrement "Game.log — Entrées" (événements détectés + corrections de lecture) — fenêtre d'UTILISATION, distincte des réglages -->
        <Border x:Name="GameLogOverlay" Background="#B3000000" Visibility="Collapsed">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                    Width="640" MaxHeight="820" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🛰 GAME.LOG — ENTRÉES" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="✕" Width="28" Height="28" Padding="0" FontSize="13" Click="CloseGameLog_Click" />
                    </Grid>

                    <TextBlock x:Name="GameLogStatusText" Grid.Row="1" Margin="0,6,0,10" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="📢 Phrases annoncées pour les événements du Game.log" FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBlock Text="Modifie le texte lu à voix haute pour chaque type d'événement détecté. Les champs entre accolades (ex. {dest}) sont remplacés automatiquement ; laisse un champ vide puis enregistre pour revenir au texte par défaut."
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <ItemsControl x:Name="GameLogPhrasesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <!-- Modifié depuis le dernier "Enregistrer" : cadre rouge, disparaît une fois enregistré (voir IsDirty, MainWindow.xaml.cs). -->
                                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="● non enregistré" Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="Bold"
                                                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                                    <Button Grid.Column="1" Content="Enregistrer" Click="SaveGameLogPhrase_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="🔧 Corrections de lecture pour des notifications précises" FontWeight="Bold" Margin="0,16,0,4" />
                            <TextBlock Text="Chaque nouvelle notification HUD du jeu apparaît automatiquement ci-dessous dès qu'elle est détectée. Modifie le texte à lire, ou laisse-le tel quel pour l'entendre lu mot pour mot."
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <ItemsControl x:Name="GameLogHudOverridesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                                                        </DataTrigger>
                                                        <!-- Après la précédente : passe le cadre en rouge si modifié depuis le dernier "Enregistrer",
                                                             y compris par-dessus le orange "nouvelle entrée" — disparaît une fois enregistré. -->
                                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap">
                                                        <Run Text="Détecté : « " /><Run Text="{Binding RawText, Mode=OneWay}" /><Run Text=" »" />
                                                    </TextBlock>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="● nouvelle entrée" Foreground="{DynamicResource AmberBrush}" FontSize="11" FontWeight="Bold"
                                                                   Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="● non enregistré" Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="Bold" Margin="8,0,0,0"
                                                                   Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding CustomText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                                    <Button Grid.Column="1" Content="Enregistrer" Click="SaveHudOverride_Click" />
                                                    <Button Grid.Column="2" Content="Supprimer" Margin="6,0,0,0" Click="DeleteHudOverride_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="🧭 Alias de destinations" FontWeight="Bold" Margin="0,16,0,4" />
                            <TextBlock Text="Nom personnalisé annoncé pour chaque identifiant brut de destination détecté (route tracée, saut quantique, arrivée)."
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <ItemsControl x:Name="GameLogDestinationAliasesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                                                        </DataTrigger>
                                                        <!-- Après la précédente : passe le cadre en rouge si modifié depuis le dernier "Enregistrer",
                                                             y compris par-dessus le orange "nouvelle entrée" — disparaît une fois enregistré. -->
                                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Foreground="{DynamicResource MutedBrush}" FontSize="11">
                                                        <Run Text="Détecté : « " /><Run Text="{Binding RawKey, Mode=OneWay}" /><Run Text=" »" />
                                                    </TextBlock>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="● nouvelle entrée" Foreground="{DynamicResource AmberBrush}" FontSize="11" FontWeight="Bold"
                                                                   Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="● non enregistré" Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="Bold" Margin="8,0,0,0"
                                                                   Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                                    <Button Grid.Column="1" Content="Enregistrer" Click="SaveDestinationAlias_Click" />
                                                    <Button Grid.Column="2" Content="Supprimer" Margin="6,0,0,0" Click="DeleteDestinationAlias_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <!-- Clavier interactif de sélection des touches de commande — port de #keyboardModal (gui/index.html). -->
        <Border x:Name="KeyboardOverlay" Background="#B3000000" Visibility="Collapsed">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                    Width="1000" MaxHeight="880" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="CHOISIR LA OU LES TOUCHES" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="✕" Width="28" Height="28" Padding="0" FontSize="13" Click="CloseKeyboard_Click" />
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SÉLECTION : " Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock x:Name="KbSelectedValueText" Grid.Column="1" Text="—" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <Button x:Name="KbCaptureButton" Grid.Column="2" Content="🎙 Détecter (appuyer sur la touche)" Click="KbCaptureButton_Click" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="DISPOSITION : " Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Button x:Name="KbLayoutFrButton" Content="AZERTY France" Tag="azerty_fr" Click="KbLayoutButton_Click" Margin="0,0,6,0" />
                        <Button x:Name="KbLayoutBeButton" Content="AZERTY Belgique" Tag="azerty_be" Click="KbLayoutButton_Click" Margin="0,0,6,0" />
                        <Button x:Name="KbLayoutQwertyButton" Content="QWERTY" Tag="qwerty" Click="KbLayoutButton_Click" />
                        <TextBlock Text="Change juste l'affichage des lettres pour correspondre à ton clavier physique — les touches réellement envoyées au jeu ne changent pas."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="360" />
                    </StackPanel>

                    <CheckBox x:Name="KbHoldCheckbox" Grid.Row="3" Content="Maintenir la touche 2 secondes (au lieu d'un appui bref)" Margin="0,0,0,8" />

                    <StackPanel Grid.Row="4" Margin="0,0,0,10">
                        <CheckBox x:Name="KbRepeatCheckbox" Content="Répéter la touche plusieurs fois" Checked="KbRepeatCheckbox_Changed" Unchecked="KbRepeatCheckbox_Changed" />
                        <StackPanel x:Name="KbRepeatFields" Orientation="Horizontal" Margin="20,6,0,0" Visibility="Collapsed">
                            <TextBlock Text="Répétitions :" VerticalAlignment="Center" />
                            <TextBox x:Name="KbRepeatCountBox" Width="50" Margin="6,0,16,0" />
                            <TextBlock Text="Délai entre chaque (s) :" VerticalAlignment="Center" />
                            <TextBox x:Name="KbRepeatDelayBox" Width="50" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel x:Name="KbMainPanel" />
                                <StackPanel Margin="18,0,0,0">
                                    <StackPanel x:Name="KbNavPanel" />
                                    <StackPanel x:Name="KbNumpadPanel" Margin="0,14,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="SOURIS" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,16,0,6" />
                            <StackPanel x:Name="KbMousePanel" Orientation="Horizontal" Margin="0,0,0,8" />
                            <Button x:Name="KbMouseCaptureButton" Content="🖱 Détecter (cliquer)" HorizontalAlignment="Stretch" Click="KbMouseCaptureButton_Click" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="6" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Effacer" Click="KbClear_Click" />
                        <Button Grid.Column="2" Content="Annuler" Click="KbCancel_Click" Margin="0,0,6,0" />
                        <Button x:Name="KbConfirmButton" Grid.Column="3" Content="Valider" Style="{StaticResource AccentPillButtonStyle}" Click="KbConfirm_Click" IsEnabled="False" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- Recouvrement "Notes de mise à jour", ouvert en cliquant sur le numéro de version du pied de page -->
        <Border x:Name="PatchNotesOverlay" Background="#B3000000" Visibility="Collapsed">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                    Width="640" MaxHeight="720" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,16,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📰 Notes de mise à jour" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="✕" Width="28" Height="28" Padding="0" FontSize="13" Click="ClosePatchNotes_Click" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="16,4,16,16" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PatchNotesContent" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
