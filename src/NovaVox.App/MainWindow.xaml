<Window x:Class="NovaVox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource BaseWindowStyle}"
        Title="NovaVox"
        Width="1000" Height="930">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Poignée de glisser (grille de points) : dessinée en vecteur, pas
             d'emoji équivalent. Les autres boutons de la liste de commandes
             (modifier/monter/descendre/écouter) utilisent de vrais emoji
             (⌨️🔼🔽▶️) — les tracés vectoriels essayés précédemment
             rendaient trop petits/peu lisibles, alors que ces emoji
             s'affichent déjà correctement ailleurs dans l'appli (en-tête,
             overlay, réglages...). -->
        <GeometryGroup x:Key="DragHandleGeometry">
            <EllipseGeometry Center="2,2" RadiusX="1.6" RadiusY="1.6" />
            <EllipseGeometry Center="10,2" RadiusX="1.6" RadiusY="1.6" />
            <EllipseGeometry Center="2,9" RadiusX="1.6" RadiusY="1.6" />
            <EllipseGeometry Center="10,9" RadiusX="1.6" RadiusY="1.6" />
            <EllipseGeometry Center="2,16" RadiusX="1.6" RadiusY="1.6" />
            <EllipseGeometry Center="10,16" RadiusX="1.6" RadiusY="1.6" />
        </GeometryGroup>

        <!-- Bouton "supprimer" : glyphe Segoe MDL2 Assets (monochrome, donc
             teintable, contrairement à l'emoji ❌ couleur utilisé avant)
             plutôt qu'un tracé vectoriel maison. Le rouge est posé
             directement sur le TextBlock de contenu (pas seulement via
             Style.Foreground) pour ne pas dépendre de l'héritage de
             Foreground à travers le ContentPresenter du template de bouton. -->
        <Style x:Key="DeleteIconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="DeleteIconGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Text" Value="&#xE74D;" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Pastille de couleur (sélecteur d'apparence de l'overlay) : le
             Background du bouton EST la couleur choisie, donc contrairement
             au style Button implicite (Theme.xaml) il ne doit JAMAIS être
             recouvert au survol/clic — seule la bordure réagit. Réutilisé
             pour les deux pastilles "Fond"/"Texte" et pour chaque couleur
             prédéfinie du popup. -->
        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Contenu principal -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- En-tête -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <!-- Logo : badge vectoriel par défaut, remplacé par une
                             image (logo.png/.jpg/.jpeg à côté de NovaVox.exe,
                             voir LoadAppLogoImage, MainWindow.xaml.cs) si
                             présente — même mécanisme que l'image de fond des
                             listes Commandes/Journal. -->
                        <Grid Width="60" Height="60" VerticalAlignment="Center">
                            <Border x:Name="DefaultLogoBadge" CornerRadius="30" Background="{DynamicResource PanelAltBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3">
                                <Path Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Width="26" Height="26"
                                      Data="M 0.5,0 L 1,0.28 L 1,0.72 L 0.5,1 L 0,0.72 L 0,0.28 Z" />
                            </Border>
                            <Image x:Name="AppLogoImage" Stretch="Uniform" Visibility="Collapsed" />
                        </Grid>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="NOVAVOX V2" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock x:Name="TopbarSubtitleText" Text="Reconnaissance vocale hors-ligne — Star Citizen" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Mode de jeu : bascule d'un coup Game.log/wiki Gemini/
                             ligne Zone de l'overlay/image de fond — indépendant des
                             profils de commandes (menu déroulant plus bas), voir
                             GameModeCombo_SelectionChanged (MainWindow.xaml.cs). -->
                        <ComboBox x:Name="GameModeCombo" Width="150" SelectionChanged="GameModeCombo_SelectionChanged">
                            <ComboBoxItem Content="🚀 Star Citizen" Tag="sc" />
                            <ComboBoxItem Content="🎮 Autre jeu" Tag="other" />
                        </ComboBox>
                        <Button x:Name="GeminiHeaderButton" Content="🌟 Assistant Gemini" Margin="8,0,0,0" Style="{StaticResource PillGhostButtonStyle}" Click="OpenGeminiChat_Click" />
                        <Button x:Name="GameLogHeaderButton" Content="🛰 Game.log" Style="{StaticResource PillGhostButtonStyle}" Margin="8,0,0,0" Click="OpenGameLog_Click" />
                        <Button x:Name="SettingsButton" Style="{StaticResource IconCircleButtonStyle}" Content="⚙️" Margin="12,0,0,0" Click="SettingsButton_Click"
                                ToolTip="Réglages" />
                        <!-- Thème de couleurs de l'interface : liste construite dynamiquement à partir de
                             ThemeManager.AvailableThemes (MainWindow.xaml.cs, InitializeThemeCombo) plutôt
                             que codée en dur ici, pour ne garder qu'un seul endroit à mettre à jour en
                             ajoutant une palette. Propre au mode de jeu actif (GameModeConfig.UiTheme, voir
                             AppState.SwitchGameMode) : "Autre jeu" démarre sur "Militaire" par défaut. -->
                        <ComboBox x:Name="ThemeCombo" Width="130" Margin="8,0,0,0" ToolTip="Thème de couleurs"
                                  SelectionChanged="ThemeCombo_SelectionChanged" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Barre de statut + bouton d'engagement -->
            <Border Grid.Row="1" Margin="16,16,16,0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Grid Width="52" Height="52" VerticalAlignment="Center">
                            <!-- Anneau tournant, plus grand que le point et centré autour de lui
                                 (Stroke/rotation pilotés depuis le code, voir SetListenIndicator
                                 dans MainWindow.xaml.cs) : orange pendant le chargement du modèle
                                 Vosk, bleu tant que l'écoute est active ; masqué et immobile à l'arrêt. -->
                            <Ellipse x:Name="StatusSpinner" StrokeThickness="3.2"
                                     StrokeDashArray="2,1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                     Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="StatusSpinnerRotate" Angle="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <!-- Point de statut : toujours affiché, quel que soit l'état. -->
                            <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="{DynamicResource MutedBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock x:Name="StatusLabelText" Text="Arrêté" FontWeight="Bold" />
                            <TextBlock x:Name="StatusText" Text="Système en veille" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="ListenToggleButton" Grid.Column="1" Content="▶ Engager l'écoute" Style="{StaticResource AccentPillButtonStyle}" Click="ListenToggleButton_Click" />
                </Grid>
            </Border>

            <!-- Commandes (gauche) + Journal système (droite), côte à côte.
                 ClipToBounds : l'image de fond ci-dessous est affichée à sa
                 taille native (non redimensionnée) et centrée — sans ce
                 clip, elle déborderait par-dessus l'en-tête/la barre de
                 statut au-dessus dès qu'elle dépasse la hauteur de cette
                 zone. -->
            <Grid Grid.Row="2" Margin="16" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Sélecteur de profil : commun aux deux colonnes, sorti de
                     la colonne Commandes pour que COMMANDES et JOURNAL
                     SYSTÈME démarrent toutes les deux juste en dessous, à la
                     même hauteur (sinon la colonne Commandes avait un en-tête
                     de plus que Journal système, et sa carte démarrait plus
                     bas). -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Profil :" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="ProfileCombo" Width="180" DisplayMemberPath="Name" SelectionChanged="ProfileCombo_SelectionChanged" />
                    <Button Content="Nouveau" Margin="6,0,0,0" Click="NewProfile_Click" />
                    <Button Content="Renommer" Margin="6,0,0,0" Click="RenameProfile_Click" />
                    <Button Content="Supprimer" Margin="6,0,0,0" Click="DeleteProfile_Click" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="360" />
                        <ColumnDefinition x:Name="JournalGapColumn" Width="16" />
                        <ColumnDefinition x:Name="JournalColumn" Width="2*" MinWidth="280" />
                    </Grid.ColumnDefinitions>

                    <!-- Image de fond : visible uniquement dans l'espace laissé
                         libre sous les listes Commandes/Journal (raccourcies
                         ci-dessous), qui la recouvrent ailleurs avec leur propre
                         fond opaque. Chargée depuis un fichier local si présent
                         (voir LoadBackgroundImage, MainWindow.xaml.cs) : absent,
                         rien ne s'affiche. Stretch="None" + centrée : gardée à
                         sa taille native plutôt que redimensionnée, pour qu'agrandir
                         la fenêtre révèle progressivement plus de l'image (comme
                         une fenêtre sur une image fixe) au lieu de la rétrécir. -->
                    <Image x:Name="PanelsBackgroundImage" Grid.Column="0" Grid.ColumnSpan="3" Stretch="None"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

                    <!-- Colonne gauche : commandes -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="3*" />
                            <RowDefinition Height="60" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="COMMANDES" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Style="{StaticResource CountBadgeStyle}" Margin="8,0,0,0">
                                <TextBlock x:Name="CommandCountText" Text="0" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12" />
                            </Border>
                            <Button Content="+ Commande" Margin="16,0,0,0" Click="AddCommand_Click" />
                            <Button Content="+ Titre" Margin="6,0,0,0" Click="AddTitle_Click" />
                            <!-- Filtre texte (phrase / touche / synonyme) : ne touche jamais
                                 à _state.Commands lui-même (glisser-déposer et ordre intacts),
                                 seulement à VoiceCommandRow.RowVisible — voir
                                 RefreshCommandsVisibility (MainWindow.xaml.cs). Placeholder
                                 manuel (TextBlock superposé) : TextBox n'en a pas nativement. -->
                            <Grid Width="120" Margin="10,0,0,0">
                                <TextBox x:Name="CommandsSearchBox" Padding="8,4" Background="{DynamicResource PanelBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                         TextChanged="CommandsSearchBox_TextChanged"
                                         ToolTip="Filtrer les commandes par phrase, touche ou synonyme" />
                                <TextBlock x:Name="CommandsSearchPlaceholder" Text="🔎 Rechercher..." Margin="10,0,0,0" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                            </Grid>
                        </StackPanel>

                        <Border x:Name="CommandsCard" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource PanelBrush50}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <ListBox x:Name="CommandsList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AllowDrop="True" PreviewMouseMove="CommandsList_PreviewMouseMove" PreviewMouseLeftButtonUp="CommandsList_PreviewMouseLeftButtonUp"
                                 DragOver="CommandsList_DragOver" DragLeave="CommandsList_DragLeave" Drop="CommandsList_Drop">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4" Visibility="{Binding RowVisible, Converter={StaticResource BoolToVis}}">
                                        <!-- Ligne "titre de groupe" : fond teinté (AccentDimBrush) pour bien
                                             se distinguer des lignes de commande, texte centré. -->
                                        <Border Visibility="{Binding IsTitle, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource AccentDimBrush}" CornerRadius="4" Padding="8,6" Margin="0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="30" Background="Transparent" Cursor="SizeAll" VerticalAlignment="Stretch"
                                                        ToolTip="Glisser pour réordonner" MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                                                    <Path Data="{StaticResource DragHandleGeometry}" Fill="{DynamicResource MutedBrush}"
                                                          Width="14" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBox Grid.Column="1" Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"
                                                         Background="Transparent" BorderThickness="0" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Width="34" Height="34" Padding="0" FontSize="15" Content="{Binding CollapseGlyph}"
                                                            Click="ToggleTitleCollapsed_Click" ToolTip="Replier/déplier ce groupe" />
                                                    <Button Width="34" Height="34" Padding="0" FontSize="15" Margin="4,0,0,0" Click="MoveUp_Click" ToolTip="Monter" Content="🔼" />
                                                    <Button Width="34" Height="34" Padding="0" FontSize="15" Margin="4,0,0,0" Click="MoveDown_Click" ToolTip="Descendre" Content="🔽" />
                                                    <Button Style="{StaticResource DeleteIconButtonStyle}" Width="34" Height="34" Margin="4,0,0,0" Click="DeleteRow_Click" ToolTip="Supprimer">
                                                        <TextBlock Style="{StaticResource DeleteIconGlyphStyle}" FontSize="16" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Ligne "commande" -->
                                        <Border Visibility="{Binding IsCommand, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="8" Margin="0,3">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="30" Background="Transparent" Cursor="SizeAll" VerticalAlignment="Stretch"
                                                            ToolTip="Glisser pour réordonner" MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                                                        <Path Data="{StaticResource DragHandleGeometry}" Fill="{DynamicResource MutedBrush}"
                                                              Width="14" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <Button Grid.Column="1" Content="{Binding KeysDisplayWithBadges}" FontFamily="Consolas" FontWeight="Bold"
                                                            Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource AccentBrush}"
                                                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="8,3" Margin="0,0,8,0"
                                                            ToolTip="Cliquer pour choisir la ou les touches (clavier interactif)" Click="CommandKeysButton_Click" />

                                                    <TextBox Grid.Column="2" Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Phrase à dire" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                    <Button Grid.Column="3" Content="{Binding SynonymsCountLabel}" Visibility="{Binding HasSynonyms, Converter={StaticResource BoolToVis}}"
                                                            Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource AccentBrush}"
                                                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                                            ToolTip="Afficher/masquer les synonymes" Click="ToggleSynonyms_Click" Margin="0,0,6,0" />

                                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                        <Button Width="34" Height="34" Padding="0" FontSize="15" Click="MoveUp_Click" ToolTip="Monter" Content="🔼" />
                                                        <Button Width="34" Height="34" Padding="0" FontSize="15" Margin="4,0,0,0" Click="MoveDown_Click" ToolTip="Descendre" Content="🔽" />
                                                        <Button Width="34" Height="34" Padding="0" FontSize="15" Margin="8,0,0,0" Click="SpeakCommand_Click" ToolTip="Écouter la phrase" Content="▶️" />
                                                        <Button Content="+ syn" Height="34" Margin="6,0,0,0" Click="AddSynonym_Click" ToolTip="Ajouter un synonyme" />
                                                        <Button Content="{Binding ExtraStepsCountLabel}" Visibility="{Binding HasExtraSteps, Converter={StaticResource BoolToVis}}"
                                                                Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource AccentBrush}"
                                                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Height="34" Margin="6,0,0,0"
                                                                ToolTip="Afficher/masquer les étapes supplémentaires" Click="ToggleExtraSteps_Click" />
                                                        <Button Content="+ étape" Height="34" Margin="6,0,0,0" Click="AddExtraStep_Click"
                                                                ToolTip="Ajouter une étape : une suite de touches jouée après l'action principale" />
                                                        <Button Width="34" Height="34" Padding="0" FontSize="15" Margin="6,0,0,0" Click="CommandKeysButton_Click" ToolTip="Modifier la touche / maintien / répétition" Content="⌨️" />
                                                        <Button Style="{StaticResource DeleteIconButtonStyle}" Width="34" Height="34" Margin="6,0,0,0" Click="DeleteRow_Click" ToolTip="Supprimer">
                                                            <TextBlock Style="{StaticResource DeleteIconGlyphStyle}" FontSize="16" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding Synonyms}" Visibility="{Binding SynonymsExpanded, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="26,2,0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                                                <Button Grid.Column="1" Width="32" Height="30" Padding="0" FontSize="14"
                                                                        Tag="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=DataContext}"
                                                                        Click="EditSynonym_Click" ToolTip="Modifier ce synonyme" Content="✏️" />
                                                                <Button Grid.Column="2" Style="{StaticResource DeleteIconButtonStyle}" Width="32" Height="30" Margin="4,0,0,0"
                                                                        Tag="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=DataContext}"
                                                                        Click="DeleteSynonym_Click" ToolTip="Supprimer ce synonyme">
                                                                    <TextBlock Style="{StaticResource DeleteIconGlyphStyle}" FontSize="14" />
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Suite de touches jouées après l'action principale (ExtraStep) —
                                                     même agencement que la liste de synonymes juste au-dessus. -->
                                                <ItemsControl ItemsSource="{Binding ExtraSteps}" Visibility="{Binding ExtraStepsExpanded, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="26,2,0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center">
                                                                    <Run Text="{Binding Keys, Mode=OneWay}" FontFamily="Consolas" />
                                                                    <Run Text=" — délai " />
                                                                    <Run Text="{Binding DelayBefore, Mode=OneWay, StringFormat={}{0:F1}s}" />
                                                                </TextBlock>
                                                                <Button Grid.Column="1" Width="32" Height="30" Padding="0" FontSize="14"
                                                                        Tag="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=DataContext}"
                                                                        Click="EditExtraStep_Click" ToolTip="Modifier cette étape" Content="✏️" />
                                                                <Button Grid.Column="2" Style="{StaticResource DeleteIconButtonStyle}" Width="32" Height="30" Margin="4,0,0,0"
                                                                        Tag="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=DataContext}"
                                                                        Click="DeleteExtraStep_Click" ToolTip="Supprimer cette étape">
                                                                    <TextBlock Style="{StaticResource DeleteIconGlyphStyle}" FontSize="14" />
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Indicateurs visuels de dépôt pendant un glisser-déposer -->
                                        <Border Height="3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top" CornerRadius="2" IsHitTestVisible="False"
                                                Visibility="{Binding IsDropTargetTop, Converter={StaticResource BoolToVis}}" />
                                        <Border Height="3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" CornerRadius="2" IsHitTestVisible="False"
                                                Visibility="{Binding IsDropTargetBottom, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <!-- Colonne droite : journal système — visibilité + largeur
                     de colonne basculées ensemble par ApplyShowSystemLog
                     (MainWindow.xaml.cs), voir ⚙️ Réglages > ⬡ NovaVox. -->
                <Grid x:Name="JournalColumnPanel" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="JOURNAL SYSTÈME" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="Effacer" Margin="16,0,0,0" Click="ClearLog_Click" />
                    </StackPanel>

                    <!-- VerticalAlignment="Top" + Height liée à la hauteur
                         RÉELLE de la carte Commandes (CommandsCard) : les
                         deux cartes font exactement la même hauteur, toujours
                         synchronisées automatiquement (la liaison se
                         réévalue à chaque redimensionnement). Le reste de
                         l'espace sous la carte révèle l'image de fond,
                         comme sous la liste Commandes. -->
                    <Border x:Name="LogCard" Grid.Row="1" VerticalAlignment="Top" Height="{Binding ActualHeight, ElementName=CommandsCard}"
                            Background="{DynamicResource PanelAltBrush50}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <!-- RichTextBox plutôt qu'un ItemsControl de TextBlock : permet de sélectionner/copier le texte du journal (IsReadOnly le protège en écriture). -->
                        <RichTextBox x:Name="LogList" IsReadOnly="True" IsDocumentEnabled="True" Background="Transparent" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="12" Padding="8,4" VerticalScrollBarVisibility="Auto" />
                    </Border>
                </Grid>
                </Grid>
            </Grid>

            <!-- Pied de page : version (clic = notes de mise à jour), crédits,
                 contact. Positionné en superposition en bas de la MÊME ligne
                 que l'image de fond (Grid.Row="2", rendu après elle donc
                 par-dessus) plutôt que dans sa propre ligne réservée, sans
                 fond (le dégradé essayé précédemment ressortait comme une
                 zone grisâtre disgracieuse sur l'image). -->
            <Border Grid.Row="2" VerticalAlignment="Bottom" Padding="16,0,16,18" IsHitTestVisible="True">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="NovaVox" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="11" />
                        <Button x:Name="FooterVersionButton" Content="v…" Margin="6,0,0,0" Padding="6,1" FontSize="11" Click="FooterVersionButton_Click" ToolTip="Voir les notes de mise à jour" />
                        <TextBlock Text=" · Développé par " Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="11" />
                        <TextBlock Text="Ammoniak007" Foreground="{DynamicResource MutedBrush}" FontWeight="Bold" VerticalAlignment="Center" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                        <TextBlock FontSize="11">
                            <Run Text="Support : 💬 " Foreground="{DynamicResource MutedBrush}" />
                            <Hyperlink NavigateUri="https://discord.gg/NhhhGKv7F" RequestNavigate="Hyperlink_RequestNavigate">Discord NovaVox</Hyperlink>
                        </TextBlock>
                        <TextBlock Text="   ·   " Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                        <TextBlock FontSize="11">
                            <Run Text="📧 " Foreground="{DynamicResource MutedBrush}" />
                            <Hyperlink NavigateUri="mailto:appnovavox@outlook.fr" RequestNavigate="Hyperlink_RequestNavigate">appnovavox@outlook.fr</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Recouvrement "Réglages", ouvert/fermé par le bouton ⚙️ de l'en-tête — pas une fenêtre séparée -->
        <Border x:Name="SettingsOverlay" Background="#B3000000" Visibility="Collapsed">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                    Width="640" MaxHeight="820" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,16,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SettingsTitleText" Grid.Column="0" Text="⚙️ Réglages" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button x:Name="CloseSettingsButton" Grid.Column="1" Content="✕" Width="28" Height="28" Padding="0" FontSize="13" Click="CloseSettings_Click" />
                    </Grid>

                    <!-- Visible uniquement tant que la configuration obligatoire du
                         premier lancement (modèle Vosk + moteur Piper) n'est pas
                         terminée — voir StartFirstLaunchSetupIfNeeded, MainWindow.xaml.cs.
                         Grid.Row="1" (au-dessus des onglets, pas par-dessus) : les
                         boutons d'installation de l'onglet Sons juste en dessous
                         doivent rester utilisables. -->
                    <Border x:Name="FirstLaunchBanner" Grid.Row="1" Margin="16,0,16,4" Background="{DynamicResource AccentDimBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Visibility="Collapsed">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}">
                            <Run Text="👋 Bienvenue !" FontWeight="Bold" />
                            <LineBreak />
                            <Run Text="Avant de pouvoir utiliser NovaVox, installe ci-dessous un modèle de reconnaissance vocale ET le moteur de synthèse Piper (onglet Sons)." />
                        </TextBlock>
                    </Border>

                    <TabControl x:Name="SettingsTabControl" Grid.Row="2" Background="Transparent" Margin="10,4,10,10">
                        <TabItem x:Name="SonsSettingsTab" Header="🔊 Sons">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <TextBlock x:Name="VoskModelLabelText" Text="Modèle de reconnaissance vocale (Vosk)" FontWeight="Bold" Margin="0,0,0,6" />
                                <TextBlock x:Name="ModelPathText" Text="Aucun modèle sélectionné" Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,4" />
                                <ItemsControl x:Name="VoskModelsList" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <Border Style="{StaticResource CountBadgeStyle}" Margin="8,0,0,0" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="✅ Installé" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="11" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Content="{Binding InstallButtonLabel}" IsEnabled="{Binding CanInstall}" Click="InstallVoskModel_Click" />
                                                        <Button Content="Désinstaller" Margin="6,0,0,0" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}" Click="UninstallVoskModel_Click" />
                                                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="BrowseModelButton" Content="Parcourir un dossier déjà téléchargé..." HorizontalAlignment="Left" Margin="0,8,0,0" Click="BrowseModel_Click" />

                                <TextBlock x:Name="MicSectionLabelText" Text="Micro" FontWeight="Bold" Margin="0,16,0,6" />
                                <ComboBox x:Name="InputDeviceCombo" Margin="0,0,0,8" SelectionChanged="InputDeviceCombo_SelectionChanged" />
                                <TextBlock x:Name="MicGainLabelText" Text="Amplification micro" />
                                <Slider x:Name="MicGainSlider" Minimum="0.1" Maximum="3.0" ValueChanged="MicGainSlider_ValueChanged" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock x:Name="MicGateLabelText" Text="Seuil de sensibilité (couper le son sous ce niveau)" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MicGateValueText" Text="Désactivé" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- Mètre de niveau micro en direct : fond = piste, MicLevelFillBar = niveau
                                     capté à l'instant (via MicLevelMonitor tant que les réglages sont ouverts
                                     et que l'écoute complète ne tourne pas déjà, sinon via
                                     VoiceOrchestrator.MicLevelChanged — voir StartMicLevelMonitorIfIdle,
                                     MainWindow.xaml.cs), MicGateMarkerLine = position du seuil réglé ci-dessous. -->
                                <Grid x:Name="MicLevelMeterTrack" Height="16" Margin="0,6,0,6" ClipToBounds="True" SizeChanged="MicLevelMeterTrack_SizeChanged">
                                    <Border Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" />
                                    <Border x:Name="MicLevelFillBar" Background="{DynamicResource AccentBrush}" CornerRadius="4" HorizontalAlignment="Left" Width="0" />
                                    <Border x:Name="MicGateMarkerLine" Background="{DynamicResource DangerBrush}" Width="2" HorizontalAlignment="Left" />
                                </Grid>
                                <Slider x:Name="MicGateSlider" Minimum="0" Maximum="4000" ValueChanged="MicGateSlider_ValueChanged" />
                                <TextBlock x:Name="MicGateHintText" Text="Lance l'écoute (ou ouvre simplement ces réglages), regarde la barre pendant que la vidéo/le bruit joue, puis pendant que tu parles normalement. Règle le curseur juste au-dessus du niveau du bruit de fond mais en-dessous du niveau de ta voix — tout ce qui reste sous le curseur sera ignoré par la reconnaissance."
                                           Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />

                                <TextBlock x:Name="ListenModeLabelText" Text="Mode d'écoute" FontWeight="Bold" Margin="0,16,0,6" />
                                <RadioButton x:Name="ListenAlwaysRadio" Content="Toujours active" GroupName="ListenMode" Checked="ListenMode_Checked" Tag="always" />
                                <RadioButton x:Name="ListenToggleRadio" Content="Touche bascule" GroupName="ListenMode" Checked="ListenMode_Checked" Tag="toggle_key" Margin="0,4,0,0" />
                                <RadioButton x:Name="ListenPttRadio" Content="Push-to-talk" GroupName="ListenMode" Checked="ListenMode_Checked" Tag="push_to_talk" Margin="0,4,0,0" />
                                <TextBlock x:Name="ListenHotkeyLabelText" Text="Touche assignée" FontWeight="SemiBold" Margin="0,6,0,2" />
                                <TextBlock x:Name="ListenHotkeyValueText" Text="Non définie" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="CaptureJoystickButton" Content="🕹 Bouton joystick" Click="CaptureJoystickButton_Click" Margin="0,0,6,0" />
                                    <Button x:Name="ClearListenHotkeyButton" Content="Effacer" Click="ClearListenHotkey_Click" />
                                </StackPanel>
                                <TextBlock x:Name="ListenHotkeyKeyboardHintText" Text="Ou saisis une combinaison clavier (ex : ctrl+f9) :" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <TextBox x:Name="ListenHotkeyBox" Margin="0,4,0,0" LostFocus="ListenHotkeyBox_LostFocus" />

                                <TextBlock x:Name="KbLayoutLabelText" Text="Disposition clavier" FontWeight="Bold" Margin="0,16,0,6" />
                                <ComboBox x:Name="KbLayoutCombo" SelectionChanged="KbLayoutCombo_SelectionChanged">
                                    <ComboBoxItem Content="AZERTY (France)" Tag="azerty_fr" />
                                    <ComboBoxItem Content="AZERTY (Belgique)" Tag="azerty_be" />
                                    <ComboBoxItem Content="QWERTY" Tag="qwerty" />
                                </ComboBox>

                                <TextBlock x:Name="VoiceOutputSectionLabelText" Text="Voix (sortie)" FontWeight="Bold" Margin="0,16,0,6" />
                                <TextBlock x:Name="OutputDeviceLabelText" Text="Périphérique de sortie" />
                                <ComboBox x:Name="OutputDeviceCombo" Margin="0,0,0,8" SelectionChanged="OutputDeviceCombo_SelectionChanged" />
                                <TextBlock x:Name="TtsVolumeLabelText" Text="Volume de la voix" />
                                <Slider x:Name="TtsVolumeSlider" Minimum="0.1" Maximum="1.5" ValueChanged="TtsVolumeSlider_ValueChanged" />
                                <CheckBox x:Name="AecEnabledCheckbox" Content="Annulation d'écho (expérimentale)" Margin="0,12,0,0" Checked="AecEnabledCheckbox_Changed" Unchecked="AecEnabledCheckbox_Changed" />
                            </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="GeminiSettingsTab" Header="🌟 IA Gemini">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="GeminiEnabledCheckbox" Content="Activer l'assistante Gemini" Checked="GeminiEnabledCheckbox_Changed" Unchecked="GeminiEnabledCheckbox_Changed" />
                                <CheckBox x:Name="GeminiWikiEnabledCheckbox" Content="Rechercher du contexte sur le wiki Star Citizen" Margin="0,6,0,0"
                                          ToolTip="À désactiver pour un profil sans rapport avec Star Citizen (voir Profil > 🕹 Autre jeu)."
                                          Checked="GeminiWikiEnabledCheckbox_Changed" Unchecked="GeminiWikiEnabledCheckbox_Changed" />
                                <TextBlock Text="Clé API" Margin="0,12,0,4" />
                                <TextBox x:Name="GeminiApiKeyBox" LostFocus="GeminiApiKeyBox_LostFocus" />
                                <TextBlock Text="Modèle" Margin="0,12,0,4" />
                                <ComboBox x:Name="GeminiModelCombo" DisplayMemberPath="Label" SelectionChanged="GeminiModelCombo_SelectionChanged" />
                                <TextBlock x:Name="GeminiModelDescText" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="Nom de l'assistante" Margin="0,12,0,4" />
                                <TextBox x:Name="GeminiNameBox" LostFocus="GeminiNameBox_LostFocus" />
                                <TextBlock Text="Ton prénom" Margin="0,12,0,4" />
                                <TextBox x:Name="UserNameBox" LostFocus="UserNameBox_LostFocus" ToolTip="Gemini t'appellera par ce prénom dans ses réponses — laisse vide pour ne pas le préciser." />
                                <TextBlock Text="Longueur des réponses" Margin="0,12,0,4" />
                                <ComboBox x:Name="GeminiResponseLengthCombo" SelectionChanged="GeminiResponseLengthCombo_SelectionChanged">
                                    <ComboBoxItem Content="Courte" Tag="short" />
                                    <ComboBoxItem Content="Normale" Tag="normal" />
                                    <ComboBoxItem Content="Longue" Tag="long" />
                                </ComboBox>
                                <TextBlock Text="Contexte personnalisé" Margin="0,12,0,4" />
                                <TextBox x:Name="GeminiContextBox" AcceptsReturn="True" Height="70" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" LostFocus="GeminiContextBox_LostFocus" />
                                <CheckBox x:Name="ConfirmCommandsCheckbox" Content="Confirmer les commandes à voix haute" Margin="0,16,0,0"
                                          Checked="ConfirmCommandsCheckbox_Changed" Unchecked="ConfirmCommandsCheckbox_Changed" />
                                <CheckBox x:Name="RadioEffectCheckbox" Content="Effet radio de vaisseau" Margin="0,8,0,0" Checked="RadioEffectCheckbox_Changed" Unchecked="RadioEffectCheckbox_Changed" />

                                <TextBlock Text="Moteur vocal (Piper)" FontWeight="Bold" Margin="0,16,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="InstallPiperEngineButton" Content="Installer le moteur Piper" Click="InstallPiperEngine_Click" />
                                    <TextBlock x:Name="PiperEngineStatusText" Text="" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock Text="Voix disponibles" FontWeight="Bold" Margin="0,16,0,6" />
                                <ItemsControl x:Name="PiperVoicesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton GroupName="PiperVoice" IsChecked="{Binding IsSelected, Mode=OneWay}" Click="SelectPiperVoice_Click"
                                                                     Content="{Binding Label}" IsEnabled="{Binding IsInstalled}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Content="Télécharger" Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}" Click="DownloadPiperVoice_Click" />
                                                        <Button Content="Supprimer" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}" Click="DeletePiperVoice_Click" Margin="6,0,0,0" />
                                                        <Button Content="Tester" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}" Click="TestPiperVoice_Click" Margin="6,0,0,0" />
                                                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Vitesse (length_scale)" Margin="0,16,0,0" />
                                <Slider x:Name="PiperLengthScaleSlider" Minimum="0.5" Maximum="2.0" ValueChanged="PiperLengthScaleSlider_ValueChanged" />
                                <TextBlock Text="Expressivité (noise_scale)" />
                                <Slider x:Name="PiperNoiseScaleSlider" Minimum="0.0" Maximum="1.5" ValueChanged="PiperNoiseScaleSlider_ValueChanged" />
                            </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem x:Name="GameLogSettingsTab" Header="🛰 Game.log">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="GameLogEnabledCheckbox" Content="Surveiller le Game.log" Checked="GameLogEnabledCheckbox_Changed" Unchecked="GameLogEnabledCheckbox_Changed" />
                                <CheckBox x:Name="GameLogAnnounceCheckbox" Content="Annoncer les changements de zone à voix haute" Margin="0,8,0,0"
                                          Checked="GameLogAnnounceCheckbox_Changed" Unchecked="GameLogAnnounceCheckbox_Changed" />
                                <TextBlock Text="Pseudo RSI" Margin="0,16,0,4" />
                                <TextBox x:Name="PlayerHandleBox" LostFocus="PlayerHandleBox_LostFocus" />

                                <TextBlock Text="Emplacement du Game.log" Margin="0,16,0,4" />
                                <TextBlock Text="Laisse vide pour une détection automatique (tous les disques sont essayés). À renseigner seulement si Star Citizen est installé ailleurs qu'un emplacement standard."
                                           Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="GameLogPathBox" Width="280" LostFocus="GameLogPathBox_LostFocus"
                                             ToolTip="Chemin complet vers Game.log (ex. D:\StarCitizen\LIVE\Game.log)" />
                                    <Button Content="Parcourir…" Margin="6,0,0,0" Click="GameLogPathBrowseButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </TabItem>

                        <TabItem x:Name="ShipCheatSheetsSettingsTab" Header="🚀 Vaisseaux">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="Aide-mémoire vaisseaux" FontWeight="Bold" />
                                    <TextBlock Text="Note tes propres repères (tourelles, côtés, accès...) pour un vaisseau — le vaisseau choisi ci-dessous est celui affiché dans l'overlay en jeu."
                                               Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12" />

                                    <TextBlock Text="Vaisseau affiché dans l'overlay" Margin="0,0,0,4" />
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="ShipCheatSheetCombo" Width="220" SelectionChanged="ShipCheatSheetCombo_SelectionChanged" />
                                        <Button Content="Supprimer ce vaisseau" Margin="6,0,0,0" Click="DeleteShipCheatSheet_Click" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBox x:Name="NewShipNameBox" Width="220" ToolTip="Nom du nouveau vaisseau (ex. Perseus)" />
                                        <Button Content="+ Ajouter un vaisseau" Margin="6,0,0,0" Click="AddShipCheatSheet_Click" />
                                    </StackPanel>

                                    <TextBlock Text="Repères" FontWeight="Bold" Margin="0,20,0,10" />
                                    <ItemsControl x:Name="ShipCheatSheetPointsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="1,1,1,1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelAltBrush}"
                                                        CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <!-- Repère : traité comme le "titre" de la fiche (accent + gras) pour
                                                             qu'il saute aux yeux face à la description juste en dessous —
                                                             les deux étaient auparavant deux TextBox identiques avec juste
                                                             une petite légende grise au-dessus, difficiles à distinguer d'un
                                                             coup d'œil (retour utilisateur). -->
                                                        <TextBlock Text="📍 REPÈRE (ex. Tourelle dorsale, Tribord...)" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold" />
                                                        <Grid Margin="0,2,0,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <!-- Le texte du repère reprend directement sa couleur choisie
                                                                 (aperçu immédiat, même couleur que dans l'overlay) plutôt
                                                                 que la teinte d'accent fixe utilisée avant. -->
                                                            <TextBox Grid.Column="0" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" LostFocus="ShipCheatSheetRow_LostFocus"
                                                                     FontWeight="Bold" Foreground="{Binding Color, Converter={StaticResource HexColorToBrush}}"
                                                                     BorderBrush="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                                                            <!-- Pastille = couleur affichée pour CE repère (indépendante des
                                                                 autres) à la fois ici et dans l'overlay en jeu — voir
                                                                 ShipCheatSheetPointColorSwatch_Click/ApplyColorPickerHex. -->
                                                            <Button Grid.Column="1" Width="30" Height="30" Style="{StaticResource ColorSwatchButtonStyle}"
                                                                    Background="{Binding Color, Converter={StaticResource HexColorToBrush}}"
                                                                    ToolTip="Couleur de ce repère (aussi affichée dans l'overlay en jeu)"
                                                                    Click="ShipCheatSheetPointColorSwatch_Click" />
                                                        </Grid>
                                                        <TextBlock Text="Description" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                                        <Grid Margin="0,2,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Grid.Column="0" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                                     LostFocus="ShipCheatSheetRow_LostFocus" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" />
                                                            <Button Grid.Column="1" Content="Supprimer" Click="DeleteShipCheatSheetPoint_Click" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="+ Ajouter un repère" HorizontalAlignment="Left" Click="AddShipCheatSheetPoint_Click" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="⬡ NovaVox">
                            <StackPanel Margin="10">
                                <TextBlock Text="Overlay en jeu" FontWeight="Bold" Margin="0,0,0,6" />
                                <CheckBox x:Name="OverlayEnabledCheckbox" Content="Activer l'overlay" Checked="OverlayEnabledCheckbox_Changed" Unchecked="OverlayEnabledCheckbox_Changed" />
                                <Button x:Name="ToggleOverlayEditButton" Content="Déplacer l'overlay" Margin="0,8,0,0" HorizontalAlignment="Left" Click="ToggleOverlayEditButton_Click" />

                                <TextBlock Text="Apparence" Margin="0,16,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Fond :" VerticalAlignment="Center" />
                                    <Button x:Name="OverlayBgColorSwatch" Width="26" Height="26" Margin="6,0,0,0"
                                            Style="{StaticResource ColorSwatchButtonStyle}" ToolTip="Choisir une couleur"
                                            Click="OverlayBgColorSwatch_Click" />
                                    <TextBox x:Name="OverlayBgColorBox" Width="80" Margin="6,0" LostFocus="OverlayAppearance_Changed" />
                                    <TextBlock Text="Opacité :" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <Slider x:Name="OverlayBgOpacitySlider" Minimum="0" Maximum="100" Width="100" Margin="6,0" ValueChanged="OverlayAppearance_Changed" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Texte :" VerticalAlignment="Center" />
                                    <Button x:Name="OverlayTextColorSwatch" Width="26" Height="26" Margin="6,0,0,0"
                                            Style="{StaticResource ColorSwatchButtonStyle}" ToolTip="Choisir une couleur"
                                            Click="OverlayTextColorSwatch_Click" />
                                    <TextBox x:Name="OverlayTextColorBox" Width="80" Margin="6,0" LostFocus="OverlayAppearance_Changed" />
                                    <TextBlock Text="Opacité :" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <Slider x:Name="OverlayTextOpacitySlider" Minimum="0" Maximum="100" Width="100" Margin="6,0" ValueChanged="OverlayAppearance_Changed" />
                                </StackPanel>

                                <CheckBox x:Name="AutolaunchCheckbox" Content="Lancer NovaVox automatiquement au démarrage de Star Citizen"
                                          Margin="0,16,0,0" Checked="AutolaunchCheckbox_Changed" Unchecked="AutolaunchCheckbox_Changed" />

                                <TextBlock Text="Interface" FontWeight="Bold" Margin="0,16,0,6" />
                                <CheckBox x:Name="ShowSystemLogCheckbox" Content="Afficher le journal système"
                                          Checked="ShowSystemLogCheckbox_Changed" Unchecked="ShowSystemLogCheckbox_Changed" />

                                <TextBlock x:Name="UiLanguageLabelText" Text="Langue de l'interface" FontWeight="Bold" Margin="0,16,0,6" />
                                <ComboBox x:Name="UiLanguageCombo" SelectionChanged="UiLanguageCombo_SelectionChanged">
                                    <ComboBoxItem Content="Français" Tag="fr" />
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="Nederlands" Tag="nl" />
                                    <ComboBoxItem Content="Español" Tag="es" />
                                    <ComboBoxItem Content="Italiano" Tag="it" />
