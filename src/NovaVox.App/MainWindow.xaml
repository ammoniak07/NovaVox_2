                    <!-- Popup de sélection de couleur partagé par plusieurs pastilles
                         (Fond/Texte de l'overlay dans l'onglet NovaVox, couleur de
                         chaque repère dans l'onglet Vaisseaux) : la cible en cours
                         d'édition est suivie par _colorPickerTarget (MainWindow.xaml.cs),
                         positionnée à l'ouverture (OverlayBgColorSwatch_Click/
                         OverlayTextColorSwatch_Click/ShipCheatSheetPointColorSwatch_Click).
                         Déclaré ICI, en dehors du TabControl (et donc de n'importe quel
                         TabItem précis), plutôt qu'à l'intérieur d'un onglet donné comme
                         avant : un TabControl WPF ne garde que le CONTENU DE L'ONGLET
                         ACTIF dans l'arbre visuel, donc un Popup déclaré dans un onglet
                         ne s'ouvrait pas (aucun effet visible au clic) tant qu'on cliquait
                         une pastille se trouvant dans un AUTRE onglet — vérifié en repro
                         réelle avec la pastille de couleur d'un repère (onglet Vaisseaux)
                         pendant que le popup restait déclaré dans l'onglet NovaVox. -->
                    <Popup x:Name="ColorPickerPopup" StaysOpen="False" AllowsTransparency="True"
                           Placement="Bottom" PopupAnimation="Fade">
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Width="230">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="ColorPickerPreview" Width="38" Height="38" CornerRadius="4"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                                    <TextBox x:Name="ColorPickerHexBox" Width="100" Margin="10,0,0,0" VerticalAlignment="Center"
                                             LostFocus="ColorPickerHexBox_LostFocus" />
                                </StackPanel>

                                <TextBlock Text="Rouge" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,10,0,2" />
                                <Slider x:Name="ColorPickerRSlider" Minimum="0" Maximum="255" ValueChanged="ColorPickerSlider_Changed" />
                                <TextBlock Text="Vert" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,2" />
                                <Slider x:Name="ColorPickerGSlider" Minimum="0" Maximum="255" ValueChanged="ColorPickerSlider_Changed" />
                                <TextBlock Text="Bleu" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,2" />
                                <Slider x:Name="ColorPickerBSlider" Minimum="0" Maximum="255" ValueChanged="ColorPickerSlider_Changed" />

                                <TextBlock Text="Couleurs prédéfinies" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,12,0,4" />
                                <UniformGrid Rows="1" Columns="8">
                                    <Button Background="#0a0e14" Tag="#0a0e14" Width="22" Height="22" Margin="2"
                                            Style="{StaticResource ColorSwatchButtonStyle}" Click="ColorPickerPreset_Click" />
                                    <Button Background="#dbe4ee" Tag="#dbe4ee" Width="22" Height="22" Margin="2"
                                            Style="{StaticResource ColorSwatchButtonStyle}" Click="ColorPickerPreset_Click" />
                                    <Button Background="#e63946" Tag="#e63946" Width="22" Height="22" Margin="2"
                                            Style="{StaticResource ColorSwatchButtonStyle}" Click="ColorPickerPreset_Click" />
                                    <Button Background="#f4a261" Tag="#f4a261" Width="22" Height="22" Margin="2"
                                            Style="{StaticResource ColorSwatchButtonStyle}" Click="ColorPickerPreset_Click" />
                                    <Button Background="#2a9d8f" Tag="#2a9d8f" Width="22" Height="22" Margin="2"
                                            Style="{StaticResource ColorSwatchButtonStyle}" Click="ColorPickerPreset_Click" />
                                    <Button Background="#4cc9f0" Tag="#4cc9f0" Width="22" Height="22" Margin="2"
                                            Style="{StaticResource ColorSwatchButtonStyle}" Click="ColorPickerPreset_Click" />
                                    <Button Background="#7209b7" Tag="#7209b7" Width="22" Height="22" Margin="2"
                                            Style="{StaticResource ColorSwatchButtonStyle}" Click="ColorPickerPreset_Click" />
                                    <Button Background="#ffffff" Tag="#ffffff" Width="22" Height="22" Margin="2"
                                            Style="{StaticResource ColorSwatchButtonStyle}" Click="ColorPickerPreset_Click" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
        </Border>

        <!-- Recouvrement "Assistant Gemini" (discussion) — fenêtre d'UTILISATION, distincte des réglages -->
        <Border x:Name="GeminiOverlay" Background="#B3000000" Visibility="Collapsed">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                    Width="560" MaxHeight="700" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="GeminiChatTitleText" Grid.Column="0" Text="🌟 Assistant Gemini" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="✕" Width="28" Height="28" Padding="0" FontSize="13" Click="CloseGeminiChat_Click" />
                    </Grid>

                    <TextBlock x:Name="GeminiWakeHintText" Grid.Row="1" Margin="0,6,0,10" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />

                    <Border Grid.Row="2" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <ScrollViewer x:Name="GeminiChatScrollViewer" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="GeminiChatList" Margin="10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,4" Padding="10,6" CornerRadius="6" MaxWidth="420">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="user">
                                                            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
                                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Role}" Value="error">
                                                            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="error">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="GeminiChatInput" Width="360" KeyDown="GeminiChatInput_KeyDown" />
                            <CheckBox x:Name="GeminiSpeakCheckbox" Content="🔊" IsChecked="True" Margin="8,0,0,0" VerticalAlignment="Center"
                                      ToolTip="Lire la réponse à voix haute" />
                            <Button Content="Envoyer" Style="{StaticResource AccentPillButtonStyle}" Margin="8,0,0,0" Click="GeminiSend_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Recouvrement "Game.log — Entrées" (événements détectés + corrections de lecture) — fenêtre d'UTILISATION, distincte des réglages -->
        <Border x:Name="GameLogOverlay" Background="#B3000000" Visibility="Collapsed">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                    Width="640" MaxHeight="820" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🛰 GAME.LOG — ENTRÉES" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="✕" Width="28" Height="28" Padding="0" FontSize="13" Click="CloseGameLog_Click" />
                    </Grid>

                    <TextBlock x:Name="GameLogStatusText" Grid.Row="1" Margin="0,6,0,10" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />

                    <!-- Recherche commune aux 3 listes ci-dessous (phrases, corrections HUD,
                         alias de destinations) — voir RefreshGameLogSearchVisibility,
                         MainWindow.xaml.cs. Ne réordonne/ne filtre rien côté données
                         (_gameLogPhraseRows/_hudOverrideRows/_destinationAliasRows intacts),
                         seulement RowVisible par ligne, même mécanique que CommandsSearchBox. -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <TextBox x:Name="GameLogSearchBox" Padding="8,6" TextChanged="GameLogSearchBox_TextChanged" />
                        <TextBlock x:Name="GameLogSearchPlaceholder" Text="🔍 Rechercher dans toutes les entrées du Game.log..."
                                   Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                    </Grid>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="📢 Phrases annoncées pour les événements du Game.log" FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBlock Text="Modifie le texte lu à voix haute pour chaque type d'événement détecté. Les champs entre accolades (ex. {dest}) sont remplacés automatiquement ; laisse un champ vide puis enregistre pour revenir au texte par défaut."
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <ItemsControl x:Name="GameLogPhrasesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                                Visibility="{Binding RowVisible, Converter={StaticResource BoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <!-- Modifié depuis le dernier "Enregistrer" : cadre rouge, disparaît une fois enregistré (voir IsDirty, MainWindow.xaml.cs). -->
                                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="● non enregistré" Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="Bold"
                                                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                                    <Button Grid.Column="1" Content="Enregistrer" Click="SaveGameLogPhrase_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="🔧 Corrections de lecture pour des notifications précises" FontWeight="Bold" Margin="0,16,0,4" />
                            <TextBlock Text="Chaque nouvelle notification HUD du jeu apparaît automatiquement ci-dessous dès qu'elle est détectée. Modifie le texte à lire, ou laisse-le tel quel pour l'entendre lu mot pour mot."
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <ItemsControl x:Name="GameLogHudOverridesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                                Visibility="{Binding RowVisible, Converter={StaticResource BoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                                                        </DataTrigger>
                                                        <!-- Après la précédente : passe le cadre en rouge si modifié depuis le dernier "Enregistrer",
                                                             y compris par-dessus le orange "nouvelle entrée" — disparaît une fois enregistré. -->
                                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap">
                                                        <Run Text="Détecté : « " /><Run Text="{Binding RawText, Mode=OneWay}" /><Run Text=" »" />
                                                    </TextBlock>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="● nouvelle entrée" Foreground="{DynamicResource AmberBrush}" FontSize="11" FontWeight="Bold"
                                                                   Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="● non enregistré" Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="Bold" Margin="8,0,0,0"
                                                                   Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding CustomText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                                    <Button Grid.Column="1" Content="Enregistrer" Click="SaveHudOverride_Click" />
                                                    <Button Grid.Column="2" Content="Supprimer" Margin="6,0,0,0" Click="DeleteHudOverride_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="🧭 Alias de destinations" FontWeight="Bold" Margin="0,16,0,4" />
                            <TextBlock Text="Nom personnalisé annoncé pour chaque identifiant brut de destination détecté (route tracée, saut quantique, arrivée)."
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <ItemsControl x:Name="GameLogDestinationAliasesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                                Visibility="{Binding RowVisible, Converter={StaticResource BoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}" />
                                                        </DataTrigger>
                                                        <!-- Après la précédente : passe le cadre en rouge si modifié depuis le dernier "Enregistrer",
                                                             y compris par-dessus le orange "nouvelle entrée" — disparaît une fois enregistré. -->
                                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Foreground="{DynamicResource MutedBrush}" FontSize="11">
                                                        <Run Text="Détecté : « " /><Run Text="{Binding RawKey, Mode=OneWay}" /><Run Text=" »" />
                                                    </TextBlock>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="● nouvelle entrée" Foreground="{DynamicResource AmberBrush}" FontSize="11" FontWeight="Bold"
                                                                   Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="● non enregistré" Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="Bold" Margin="8,0,0,0"
                                                                   Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                                    <Button Grid.Column="1" Content="Enregistrer" Click="SaveDestinationAlias_Click" />
                                                    <Button Grid.Column="2" Content="Supprimer" Margin="6,0,0,0" Click="DeleteDestinationAlias_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <!-- Clavier interactif de sélection des touches de commande — port de #keyboardModal (gui/index.html). -->
