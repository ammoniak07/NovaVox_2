<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette "Ambre" (terminal rétro ambre sur noir) — voir le
         commentaire de Theme.Dark.xaml pour la structure des clés. -->
    <Color x:Key="BgColor">#0C0A06</Color>
    <Color x:Key="PanelColor">#16120A</Color>
    <Color x:Key="PanelAltColor">#201A0E</Color>
    <Color x:Key="BorderColor">#3D3018</Color>
    <Color x:Key="TextColor">#FFD37A</Color>
    <Color x:Key="MutedColor">#B08A45</Color>
    <Color x:Key="AccentColor">#FFB000</Color>
    <Color x:Key="AmberColor">#FF8800</Color>
    <Color x:Key="DangerColor">#FF4136</Color>
    <Color x:Key="SuccessColor">#9ACD32</Color>
    <Color x:Key="SelectionColor">#4D3B12</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentColor}" Opacity="0.18" />
    <SolidColorBrush x:Key="PanelBrush50" Color="{StaticResource PanelColor}" Opacity="0.5" />
    <SolidColorBrush x:Key="PanelAltBrush50" Color="{StaticResource PanelAltColor}" Opacity="0.5" />

</ResourceDictionary>
