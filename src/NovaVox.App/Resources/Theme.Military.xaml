<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette "Militaire" (HUD tactique olive/kaki) : thème par défaut du
         mode "Autre jeu" (voir GameModeConfig.ForOther), sélectionnable pour
         n'importe quel mode via ThemeCombo (en-tête, MainWindow.xaml). Même
         structure de clés que Theme.Dark.xaml/Theme.Light.xaml — voir le
         commentaire là-bas pour pourquoi un Brush indépendant par thème. -->
    <Color x:Key="BgColor">#12160D</Color>
    <Color x:Key="PanelColor">#1B2115</Color>
    <Color x:Key="PanelAltColor">#262F1B</Color>
    <Color x:Key="BorderColor">#3B4A2A</Color>
    <Color x:Key="TextColor">#DCE0C6</Color>
    <Color x:Key="MutedColor">#8A9678</Color>
    <Color x:Key="AccentColor">#8FBF3F</Color>
    <Color x:Key="AmberColor">#C8A951</Color>
    <Color x:Key="DangerColor">#D9534F</Color>
    <Color x:Key="SuccessColor">#6FAE4A</Color>
    <Color x:Key="SelectionColor">#33401F</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentColor}" Opacity="0.18" />
    <SolidColorBrush x:Key="PanelBrush50" Color="{StaticResource PanelColor}" Opacity="0.5" />
    <SolidColorBrush x:Key="PanelAltBrush50" Color="{StaticResource PanelAltColor}" Opacity="0.5" />

</ResourceDictionary>
